\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Origin of each grid value used in Fig.~\ref {fig:Factorization_ratios_Pb034_eta8_PL-1}. ``Quad.\ $(b_1^2, b_2^2, b_3^2)$'' means the parabola in $b^2$ through the data at those three points on the same $P\cdot b$ row; ``lin.\ $[b_a^2, b_b^2]$'' means linear interpolation in $b^2$ between the data at $b_a^2$ and $b_b^2$. Where a cell has two entries, the upper one gives the linear points (circles) and the lower one the quadratic points (triangles) of Fig.~\ref {fig:Factorization_ratios_Pb034_eta8_PL-1}. The pattern is the same for all three amplitudes.\relax }}{124}{table.caption.79}\protected@file@percent }
\newlabel{tab:factorization_grid}{{17}{124}{Origin of each grid value used in Fig.~\ref {fig:Factorization_ratios_Pb034_eta8_PL-1}. ``Quad.\ $(b_1^2, b_2^2, b_3^2)$'' means the parabola in $b^2$ through the data at those three points on the same $P\cdot b$ row; ``lin.\ $[b_a^2, b_b^2]$'' means linear interpolation in $b^2$ between the data at $b_a^2$ and $b_b^2$. Where a cell has two entries, the upper one gives the linear points (circles) and the lower one the quadratic points (triangles) of Fig.~\ref {fig:Factorization_ratios_Pb034_eta8_PL-1}. The pattern is the same for all three amplitudes.\relax }{table.caption.79}{}}
\newlabel{tab:factorization_grid@cref}{{[table][17][]17}{[1][123][]124}}
\@writefile{lof}{\contentsline {figure}{\numberline {68}{\ignorespaces Factorization ratio test at $\eta |v|/a = 8$, $P_L = -1$ ($\hat  {\zeta } = 0.090772$) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Im}}$ and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text  {Re}}$. Top row: $T(P\cdot b, b^2)$ of Eq.~\eqref  {eq:factorization_T}, the ratio to the $P\cdot b = 4$ row, plotted against $b^2$. Bottom row: $B(P\cdot b, b^2)$ of Eq.~\eqref  {eq:factorization_B}, the ratio to $b^2 = 18$, plotted against $P\cdot b$. Under factorization, every set of points is flat. Filled circles use linear interpolation in $b^2$ on all three rows. Open triangles use quadratic interpolation on the $P\cdot b = 0$ and $4$ rows and linear interpolation on the $P\cdot b = 3$ row (Table~\ref {tab:factorization_grid}). A triangle is omitted where both schemes give the same value, which happens for every point that involves only the $P\cdot b = 3$ row and data points. Error bars are Jackknife errors and do not include any uncertainty from the interpolation.\relax }}{124}{figure.caption.80}\protected@file@percent }
\newlabel{fig:Factorization_ratios_Pb034_eta8_PL-1}{{68}{124}{Factorization ratio test at $\eta |v|/a = 8$, $P_L = -1$ ($\hat {\zeta } = 0.090772$) for $\tAmp _{2B}^{\text {Re}}$, $\tAmp _{2B}^{\text {Im}}$ and $\tAmp _{12B}^{\text {Re}}$. Top row: $T(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_T}, the ratio to the $P\cdot b = 4$ row, plotted against $b^2$. Bottom row: $B(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_B}, the ratio to $b^2 = 18$, plotted against $P\cdot b$. Under factorization, every set of points is flat. Filled circles use linear interpolation in $b^2$ on all three rows. Open triangles use quadratic interpolation on the $P\cdot b = 0$ and $4$ rows and linear interpolation on the $P\cdot b = 3$ row (Table~\ref {tab:factorization_grid}). A triangle is omitted where both schemes give the same value, which happens for every point that involves only the $P\cdot b = 3$ row and data points. Error bars are Jackknife errors and do not include any uncertainty from the interpolation.\relax }{figure.caption.80}{}}
