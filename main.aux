\@writefile{lof}{\contentsline {figure}{\numberline {75}{\ignorespaces $R_b(x) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(x,0.34\text  { fm})$ for four values of $|b_T|$, as a function of $x$. Under exact factorization each curve would be flat; instead every curve rises from its $x\to 0$ value to a peak near $x\approx 0.1$ before decaying, showing that the $|b_T|$-dependence of the Sivers shift is itself $x$-dependent.\relax }}{122}{figure.caption.90}\protected@file@percent }
\newlabel{fig:factorization_ratio_x_sivers}{{75}{122}{$R_b(x) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(x,0.34\text { fm})$ for four values of $|b_T|$, as a function of $x$. Under exact factorization each curve would be flat; instead every curve rises from its $x\to 0$ value to a peak near $x\approx 0.1$ before decaying, showing that the $|b_T|$-dependence of the Sivers shift is itself $x$-dependent.\relax }{figure.caption.90}{}}
\newlabel{fig:factorization_ratio_x_sivers@cref}{{[figure][75][]75}{[1][122][]122}}
