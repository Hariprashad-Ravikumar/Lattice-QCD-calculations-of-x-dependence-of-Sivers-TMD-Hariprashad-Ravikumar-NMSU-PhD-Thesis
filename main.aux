\@writefile{lof}{\contentsline {figure}{\numberline {69}{\ignorespaces Fits testing the separability hypothesis. Pairing an exponential decay in $(P\cdot b)$ with a Gaussian transverse profile gives a poor fit ($\chi ^2/\text  {dof} \approx 4.98$). In models with a lower $\chi ^2/\text  {dof}$, the coefficient $c$ consistently fits to zero within uncertainties and is negative in each Jackknife set, so the data reject the separability hypothesis.\relax }}{126}{figure.caption.81}\protected@file@percent }
\newlabel{fig:rejection_gaussian_transverse}{{69}{126}{Fits testing the separability hypothesis. Pairing an exponential decay in $(P\cdot b)$ with a Gaussian transverse profile gives a poor fit ($\chi ^2/\text {dof} \approx 4.98$). In models with a lower $\chi ^2/\text {dof}$, the coefficient $c$ consistently fits to zero within uncertainties and is negative in each Jackknife set, so the data reject the separability hypothesis.\relax }{figure.caption.81}{}}
\newlabel{fig:rejection_gaussian_transverse@cref}{{[figure][69][]69}{[1][126][]126}}
\@writefile{lof}{\contentsline {figure}{\numberline {70}{\ignorespaces Fits testing the separability hypothesis with $\eta $-dependent $c$, written $c(\eta )$. In models with a lower $\chi ^2/\text  {dof}$, the coefficient $c$ is now positive.\relax }}{127}{figure.caption.82}\protected@file@percent }
\newlabel{fig:rejection_etadep_c}{{70}{127}{Fits testing the separability hypothesis with $\eta $-dependent $c$, written $c(\eta )$. In models with a lower $\chi ^2/\text {dof}$, the coefficient $c$ is now positive.\relax }{figure.caption.82}{}}
\newlabel{fig:rejection_etadep_c@cref}{{[figure][70][]70}{[1][126][]127}}
