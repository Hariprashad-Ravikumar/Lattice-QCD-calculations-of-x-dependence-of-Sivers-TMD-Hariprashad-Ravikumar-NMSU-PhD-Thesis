\@writefile{lof}{\contentsline {figure}{\numberline {76}{\ignorespaces $R_x(|b_T|) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(0.3,|b_T|)$ for four values of $x$, as a function of $|b_T|$. The $x=0.2$ curve varies by more than a factor of two across the fitted $|b_T|$ range rather than remaining flat, confirming that the $x$-dependence of the Sivers shift is itself $|b_T|$-dependent, consistent with Fig.~\ref {fig:factorization_ratio_x_sivers}.\relax }}{123}{figure.caption.91}\protected@file@percent }
\newlabel{fig:factorization_ratio_bT_sivers}{{76}{123}{$R_x(|b_T|) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(0.3,|b_T|)$ for four values of $x$, as a function of $|b_T|$. The $x=0.2$ curve varies by more than a factor of two across the fitted $|b_T|$ range rather than remaining flat, confirming that the $x$-dependence of the Sivers shift is itself $|b_T|$-dependent, consistent with Fig.~\ref {fig:factorization_ratio_x_sivers}.\relax }{figure.caption.91}{}}
