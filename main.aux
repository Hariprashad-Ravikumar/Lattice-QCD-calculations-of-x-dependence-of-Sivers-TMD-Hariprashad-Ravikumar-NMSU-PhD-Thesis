\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Schematic picture of the Sivers effect. For a nucleon moving into the page ($\ensuremath  {\boldsymbol  {P}}$ along $\hat  {\ensuremath  {\boldsymbol  {z}}}$) with transverse spin $\ensuremath  {\boldsymbol  {S}}_{\mathrm  T}$ along $\hat  {\ensuremath  {\boldsymbol  {y}}}$, the second term of Eq.~\eqref  {eq:intro_sivers_density} becomes $-\,k_x f_{1T}^\perp /m_N$. A nonzero Sivers function therefore shifts the density of unpolarized quarks along $\hat  {\ensuremath  {\boldsymbol  {x}}}$, perpendicular to both $\ensuremath  {\boldsymbol  {P}}$ and $\ensuremath  {\boldsymbol  {S}}_{\mathrm  T}$ (solid circle), relative to the symmetric unpolarized distribution (dashed). The shift shown, toward $+\hat  {\ensuremath  {\boldsymbol  {x}}}$, corresponds to $f_{1T}^\perp <0$.\relax }}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:intro_sivers_cartoon}{{2}{5}{Schematic picture of the Sivers effect. For a nucleon moving into the page ($\vect {P}$ along $\hat {\vect {z}}$) with transverse spin $\vprp {S}$ along $\hat {\vect {y}}$, the second term of Eq.~\eqref {eq:intro_sivers_density} becomes $-\,k_x f_{1T}^\perp /\mN $. A nonzero Sivers function therefore shifts the density of unpolarized quarks along $\hat {\vect {x}}$, perpendicular to both $\vect {P}$ and $\vprp {S}$ (solid circle), relative to the symmetric unpolarized distribution (dashed). The shift shown, toward $+\hat {\vect {x}}$, corresponds to $f_{1T}^\perp <0$.\relax }{figure.caption.5}{}}
\newlabel{fig:intro_sivers_cartoon@cref}{{[figure][2][]2}{[1][4][]5}}
