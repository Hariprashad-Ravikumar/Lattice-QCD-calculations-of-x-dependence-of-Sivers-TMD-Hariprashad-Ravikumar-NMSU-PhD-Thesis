\@writefile{lof}{\contentsline {figure}{\numberline {40}{\ignorespaces Straight-line test for an exponential decay in $|\ensuremath  {\boldsymbol  {b}}|=\sqrt  {b^2}$. A profile $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}}\propto e^{-c|\ensuremath  {\boldsymbol  {b}}|}$ is a straight line on a logarithmic ordinate versus $|\ensuremath  {\boldsymbol  {b}}|/a$ (red dashed line, best fit $c=0.579$ with the same $\eta $ factor as the Gaussian baseline of Figure~\ref {fig:gaussian_straightline_test}). The \texttt  {PySR} power law $(1+b^2)^{-1.39}$ (blue solid line) is shown for comparison. Over $3\le |\ensuremath  {\boldsymbol  {b}}|/a\le 8.2$ the exponential describes $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}}$ at least as well as the power law.\relax }}{117}{figure.caption.54}\protected@file@percent }
\newlabel{fig:exp_b_straightline_test}{{40}{117}{Straight-line test for an exponential decay in $|\vect {b}|=\sqrt {b^2}$. A profile $\tAmp _{2B}^{\text {Re}}\propto e^{-c|\vect {b}|}$ is a straight line on a logarithmic ordinate versus $|\vect {b}|/a$ (red dashed line, best fit $c=0.579$ with the same $\eta $ factor as the Gaussian baseline of Figure~\ref {fig:gaussian_straightline_test}). The \texttt {PySR} power law $(1+b^2)^{-1.39}$ (blue solid line) is shown for comparison. Over $3\le |\vect {b}|/a\le 8.2$ the exponential describes $\tAmp _{2B}^{\text {Re}}$ at least as well as the power law.\relax }{figure.caption.54}{}}
\newlabel{fig:exp_b_straightline_test@cref}{{[figure][40][]40}{[1][117][]117}}
