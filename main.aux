\@writefile{lof}{\contentsline {figure}{\numberline {70}{\ignorespaces Factorization ratio test at $\eta |v|/a = 8$, $P_L = -1$ ($\hat  {\zeta } = 0.090772$) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Im}}$ and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text  {Re}}$. Top row: $T(P\cdot b, b^2)$ of Eq.~\eqref  {eq:factorization_T}, the ratio to the $P\cdot b = 4$ row, plotted against $b^2$. Bottom row: $B(P\cdot b, b^2)$ of Eq.~\eqref  {eq:factorization_B}, the ratio to $b^2 = 18$, plotted against $P\cdot b$. Under factorization, every set of points should be flat. Filled circles use linear interpolation in $b^2$ on all three rows. Open triangles use quadratic interpolation on the $P\cdot b = 0$ and $4$ rows and linear interpolation on the $P\cdot b = 3$ row (Table~\ref {tab:factorization_grid}). A triangle is omitted where both schemes give the same value, which happens for every point that involves only the $P\cdot b = 3$ row and data points. Error bars are Jackknife errors and do not include any uncertainty from the interpolation.\relax }}{152}{figure.caption.101}\protected@file@percent }
\newlabel{fig:Factorization_ratios_Pb034_eta8_PL-1}{{70}{152}{Factorization ratio test at $\eta |v|/a = 8$, $P_L = -1$ ($\hat {\zeta } = 0.090772$) for $\tAmp _{2B}^{\text {Re}}$, $\tAmp _{2B}^{\text {Im}}$ and $\tAmp _{12B}^{\text {Re}}$. Top row: $T(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_T}, the ratio to the $P\cdot b = 4$ row, plotted against $b^2$. Bottom row: $B(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_B}, the ratio to $b^2 = 18$, plotted against $P\cdot b$. Under factorization, every set of points should be flat. Filled circles use linear interpolation in $b^2$ on all three rows. Open triangles use quadratic interpolation on the $P\cdot b = 0$ and $4$ rows and linear interpolation on the $P\cdot b = 3$ row (Table~\ref {tab:factorization_grid}). A triangle is omitted where both schemes give the same value, which happens for every point that involves only the $P\cdot b = 3$ row and data points. Error bars are Jackknife errors and do not include any uncertainty from the interpolation.\relax }{figure.caption.101}{}}
\newlabel{fig:Factorization_ratios_Pb034_eta8_PL-1@cref}{{[figure][70][]70}{[1][151][]152}}
