\@writefile{lof}{\contentsline {figure}{\numberline {73}{\ignorespaces Comparison, at fixed $|b_T| = 3a \approx 0.34$ fm, between the six physical quantities evaluated at each of the three finite momenta used in the extrapolation ($P_L=-2,-3,-4$, colored curves, each using its own unextrapolated fit parameters) and the extrapolated $\hat  \zeta \to \infty $ result (black dashed curve). The extrapolated curve is distinct from all three finite-momentum curves rather than coinciding with the largest simulated momentum, confirming that the fit-parameter extrapolation of Fig.~\ref {fig:param_extrapolation_zetahat} captures genuine momentum dependence rather than simply reproducing the $P_L=-4$ result.\relax }}{119}{figure.caption.87}\protected@file@percent }
\newlabel{fig:momenta_vs_extrapolated}{{73}{119}{Comparison, at fixed $|b_T| = 3a \approx 0.34$ fm, between the six physical quantities evaluated at each of the three finite momenta used in the extrapolation ($P_L=-2,-3,-4$, colored curves, each using its own unextrapolated fit parameters) and the extrapolated $\hat \zeta \to \infty $ result (black dashed curve). The extrapolated curve is distinct from all three finite-momentum curves rather than coinciding with the largest simulated momentum, confirming that the fit-parameter extrapolation of Fig.~\ref {fig:param_extrapolation_zetahat} captures genuine momentum dependence rather than simply reproducing the $P_L=-4$ result.\relax }{figure.caption.87}{}}
