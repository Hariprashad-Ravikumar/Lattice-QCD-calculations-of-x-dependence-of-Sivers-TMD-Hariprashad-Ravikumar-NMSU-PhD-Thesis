\@writefile{lof}{\contentsline {figure}{\numberline {67}{\ignorespaces Fit results testing the validity of the separability hypothesis: an exponential decay in $(P\cdot b)$ is paired with a Gaussian transverse profile; the fit is poor ($\chi ^2/\text  {dof} \approx 4.98$). In models that achieve a lower $\chi ^2/\text  {dof}$, the coefficient $c$ consistently fits to zero within uncertainties and is negative in each Jackknife set, demonstrating that the data rejects the separability hypothesis.\relax }}{110}{figure.caption.79}\protected@file@percent }
\newlabel{fig:rejection_gaussian_transverse}{{67}{110}{Fit results testing the validity of the separability hypothesis: an exponential decay in $(P\cdot b)$ is paired with a Gaussian transverse profile; the fit is poor ($\chi ^2/\text {dof} \approx 4.98$). In models that achieve a lower $\chi ^2/\text {dof}$, the coefficient $c$ consistently fits to zero within uncertainties and is negative in each Jackknife set, demonstrating that the data rejects the separability hypothesis.\relax }{figure.caption.79}{}}
\newlabel{fig:rejection_gaussian_transverse@cref}{{[figure][67][]67}{[1][110][]110}}
\@writefile{lof}{\contentsline {figure}{\numberline {68}{\ignorespaces Fit results testing the validity of the separability hypothesis with $\eta $-dependent $c$, as $c(\eta )$. In models that achieve a lower $\chi ^2/\text  {dof}$, the coefficient $c$ is now positive\relax }}{111}{figure.caption.80}\protected@file@percent }
\newlabel{fig:rejection_etadep_c}{{68}{111}{Fit results testing the validity of the separability hypothesis with $\eta $-dependent $c$, as $c(\eta )$. In models that achieve a lower $\chi ^2/\text {dof}$, the coefficient $c$ is now positive\relax }{figure.caption.80}{}}
\newlabel{fig:rejection_etadep_c@cref}{{[figure][68][]68}{[1][110][]111}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Comparison of the four factorized longitudinal-transverse models across nucleon momenta $P_L$, with extracted parameters shown at $P_L = -1$. While models with power-law transverse envelopes describe $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}}$ passably, all four factorized ansatze fail on $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Im}}$ and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text  {Re}}$.\relax }}{112}{table.caption.81}\protected@file@percent }
\newlabel{tab:factorized_ansatze_comparison}{{18}{112}{Comparison of the four factorized longitudinal-transverse models across nucleon momenta $P_L$, with extracted parameters shown at $P_L = -1$. While models with power-law transverse envelopes describe $\tAmp _{2B}^{\text {Re}}$ passably, all four factorized ansatze fail on $\tAmp _{2B}^{\text {Im}}$ and $\tAmp _{12B}^{\text {Re}}$.\relax }{table.caption.81}{}}
