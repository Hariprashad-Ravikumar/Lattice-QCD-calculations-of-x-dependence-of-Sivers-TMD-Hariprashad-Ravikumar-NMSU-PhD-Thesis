\@writefile{lof}{\contentsline {figure}{\numberline {81}{\ignorespaces $R_b(x) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(x,0.34\text  { fm})$ for four values of $|b_T|$, as a function of $x$. Under exact factorization each curve would be flat. Instead, every curve rises from its $x\to 0$ value to a peak near $x\approx 0.1$ before decaying, so the $|b_T|$-dependence of the Sivers shift itself depends on $x$.\relax }}{168}{figure.caption.115}\protected@file@percent }
\newlabel{fig:factorization_ratio_x_sivers}{{81}{168}{$R_b(x) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(x,0.34\text { fm})$ for four values of $|b_T|$, as a function of $x$. Under exact factorization each curve would be flat. Instead, every curve rises from its $x\to 0$ value to a peak near $x\approx 0.1$ before decaying, so the $|b_T|$-dependence of the Sivers shift itself depends on $x$.\relax }{figure.caption.115}{}}
\newlabel{fig:factorization_ratio_x_sivers@cref}{{[figure][81][]81}{[1][168][]168}}
\@writefile{lof}{\contentsline {figure}{\numberline {82}{\ignorespaces $R_x(|b_T|) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(0.3,|b_T|)$ for four values of $x$, as a function of $|b_T|$. The $x=0.2$ curve changes by more than a factor of two across the fitted $|b_T|$ range instead of staying flat, so the $x$-dependence of the Sivers shift itself depends on $|b_T|$, consistent with Fig.~\ref {fig:factorization_ratio_x_sivers}.\relax }}{169}{figure.caption.116}\protected@file@percent }
\newlabel{fig:factorization_ratio_bT_sivers}{{82}{169}{$R_x(|b_T|) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(0.3,|b_T|)$ for four values of $x$, as a function of $|b_T|$. The $x=0.2$ curve changes by more than a factor of two across the fitted $|b_T|$ range instead of staying flat, so the $x$-dependence of the Sivers shift itself depends on $|b_T|$, consistent with Fig.~\ref {fig:factorization_ratio_x_sivers}.\relax }{figure.caption.116}{}}
\newlabel{fig:factorization_ratio_bT_sivers@cref}{{[figure][82][]82}{[1][168][]169}}
\@writefile{lof}{\contentsline {figure}{\numberline {83}{\ignorespaces The same ratio test as Fig.~\ref {fig:factorization_ratio_x_sivers}, $R_b(x)$, repeated at each finite momentum individually using its own raw (unextrapolated) fit parameters. None of the four panels shows a flat curve, so the non-factorization is a feature of the fitted amplitudes and not an artifact of the $\hat  \zeta \to \infty $ extrapolation.\relax }}{170}{figure.caption.117}\protected@file@percent }
\newlabel{fig:factorization_ratio_x_finitePL}{{83}{170}{The same ratio test as Fig.~\ref {fig:factorization_ratio_x_sivers}, $R_b(x)$, repeated at each finite momentum individually using its own raw (unextrapolated) fit parameters. None of the four panels shows a flat curve, so the non-factorization is a feature of the fitted amplitudes and not an artifact of the $\hat \zeta \to \infty $ extrapolation.\relax }{figure.caption.117}{}}
\newlabel{fig:factorization_ratio_x_finitePL@cref}{{[figure][83][]83}{[1][169][]170}}
\@writefile{lof}{\contentsline {figure}{\numberline {84}{\ignorespaces The same ratio test as Fig.~\ref {fig:factorization_ratio_bT_sivers}, $R_x(|b_T|)$, repeated at each finite momentum individually. The departure from flatness grows with $|P_L|$, most visibly in the $x=0.2$ curve, which is consistent with the parameter mismatch identified in the extrapolated $j_X$ and $d_X$ values above.\relax }}{171}{figure.caption.118}\protected@file@percent }
\newlabel{fig:factorization_ratio_bT_finitePL}{{84}{171}{The same ratio test as Fig.~\ref {fig:factorization_ratio_bT_sivers}, $R_x(|b_T|)$, repeated at each finite momentum individually. The departure from flatness grows with $|P_L|$, most visibly in the $x=0.2$ curve, which is consistent with the parameter mismatch identified in the extrapolated $j_X$ and $d_X$ values above.\relax }{figure.caption.118}{}}
\newlabel{fig:factorization_ratio_bT_finitePL@cref}{{[figure][84][]84}{[1][170][]171}}
