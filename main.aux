\newlabel{fig:factorization_ratio_bT_finitePL}{{80}{142}{The same ratio test as Fig.~\ref {fig:factorization_ratio_bT_sivers}, $R_x(|b_T|)$, repeated at each finite momentum individually. The departure from flatness grows with $|P_L|$, most visibly in the $x=0.2$ curve, which is consistent with the parameter mismatch identified in the extrapolated $j_X$ and $d_X$ values above.\relax }{figure.caption.95}{}}
\newlabel{fig:factorization_ratio_bT_finitePL@cref}{{[figure][80][]80}{[1][139][]142}}
\@writefile{lof}{\contentsline {figure}{\numberline {81}{\ignorespaces Optimal separable factor $g(x)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows (normalized so $\text  {mean}[g^2]=1$). Each amplitude's $g(x)$ is dominated by a sharp rise as $x\to 0$, which steepens as the window narrows and reflects the Bessel-function behavior at small $x$.\relax }}{143}{figure.caption.97}\protected@file@percent }
\newlabel{fig:factorization_g_amplitudes}{{81}{143}{Optimal separable factor $g(x)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows (normalized so $\text {mean}[g^2]=1$). Each amplitude's $g(x)$ is dominated by a sharp rise as $x\to 0$, which steepens as the window narrows and reflects the Bessel-function behavior at small $x$.\relax }{figure.caption.97}{}}
\newlabel{fig:factorization_g_amplitudes@cref}{{[figure][81][]81}{[1][140][]143}}
\@writefile{lof}{\contentsline {figure}{\numberline {82}{\ignorespaces Optimal separable factor $h(|b_T|)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows. For all four amplitudes, $h(|b_T|)$ falls smoothly with increasing $|b_T|$, but its magnitude and slope depend on the $x$-window used to define the fit, which itself signals imperfect factorization.\relax }}{144}{figure.caption.98}\protected@file@percent }
\newlabel{fig:factorization_h_amplitudes}{{82}{144}{Optimal separable factor $h(|b_T|)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows. For all four amplitudes, $h(|b_T|)$ falls smoothly with increasing $|b_T|$, but its magnitude and slope depend on the $x$-window used to define the fit, which itself signals imperfect factorization.\relax }{figure.caption.98}{}}
\newlabel{fig:factorization_h_amplitudes@cref}{{[figure][82][]82}{[1][141][]144}}
