\@writefile{lof}{\contentsline {figure}{\numberline {71}{\ignorespaces Unpolarized and Sivers TMD amplitudes reconstructed from the extrapolated ($\hat  \zeta \to \infty $) fit parameters of Fig.~\ref {fig:param_extrapolation_zetahat}, evaluated as continuous functions of $x$ at fixed transverse separation $|b_T| = 3a \approx 0.34$ fm: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}}$, $i\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Im}}$, the full unpolarized combination $\tilde  f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$, the Sivers combination $\tilde  f_1^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text  {Re}}$, and the resulting Sivers shift $\langle k_y \rangle _{TU}$ and $x\langle k_y \rangle _{TU}$, the latter two restricted to the quark region $x\ge 0$. Shaded bands are the Jackknife uncertainty propagated from the twelve extrapolated parameters.\relax }}{116}{figure.caption.84}\protected@file@percent }
\newlabel{fig:extrapolated_amplitude_level}{{71}{116}{Unpolarized and Sivers TMD amplitudes reconstructed from the extrapolated ($\hat \zeta \to \infty $) fit parameters of Fig.~\ref {fig:param_extrapolation_zetahat}, evaluated as continuous functions of $x$ at fixed transverse separation $|b_T| = 3a \approx 0.34$ fm: $\tAmp _{2B}^{\text {Re}}$, $i\tAmp _{2B}^{\text {Im}}$, the full unpolarized combination $\tilde f_1^{(0)}=2\tAmp _{2B}$, the Sivers combination $\tilde f_1^{\perp (1)}=-2\tAmp _{12B}^{\text {Re}}$, and the resulting Sivers shift $\langle k_y \rangle _{TU}$ and $x\langle k_y \rangle _{TU}$, the latter two restricted to the quark region $x\ge 0$. Shaded bands are the Jackknife uncertainty propagated from the twelve extrapolated parameters.\relax }{figure.caption.84}{}}
\newlabel{fig:extrapolated_amplitude_level@cref}{{[figure][71][]71}{[1][115][]116}}
