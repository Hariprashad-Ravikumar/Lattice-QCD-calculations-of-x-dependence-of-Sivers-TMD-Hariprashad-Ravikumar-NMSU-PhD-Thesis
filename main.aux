\newlabel{sec:conclusion}{{8}{144}{CONCLUSION}{section.8}{}}
\newlabel{sec:conclusion@cref}{{[section][8][]8}{[1][144][]144}}
\@writefile{lof}{\contentsline {figure}{\numberline {83}{\ignorespaces Reconstructed $g(x)h(|b_T|)$ (dashed) against the actual extrapolated amplitude data (solid) at the smallest and largest fitted $|b_T|$, using the $x\in [0,1]$ fit, for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}. The largest reconstruction gap appears near $x\to 0$ for every amplitude, consistent with the $x\in [0,1]$ column of Table~\ref {tab:factorization_amplitudes} having the largest relative distance in every row.\relax }}{145}{figure.caption.99}\protected@file@percent }
\newlabel{fig:factorization_reconstruction_amplitudes}{{83}{145}{Reconstructed $g(x)h(|b_T|)$ (dashed) against the actual extrapolated amplitude data (solid) at the smallest and largest fitted $|b_T|$, using the $x\in [0,1]$ fit, for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}. The largest reconstruction gap appears near $x\to 0$ for every amplitude, consistent with the $x\in [0,1]$ column of Table~\ref {tab:factorization_amplitudes} having the largest relative distance in every row.\relax }{figure.caption.99}{}}
\newlabel{fig:factorization_reconstruction_amplitudes@cref}{{[figure][83][]83}{[1][141][]145}}
