\@writefile{lof}{\contentsline {figure}{\numberline {42}{\ignorespaces The top \texttt  {PySR} analytical models ($C = 11, 14, 16, 17$) compared with the lattice data for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}}$ at fixed staple extents $\eta = 6, 7, 8, 10$ (with $P_1 = -1$ and $|\ensuremath  {\boldsymbol  {b}}| \geq 3a$). Each panel shows the amplitude as a function of the longitudinal separation $b_L/a$ at fixed transverse separations $b_T$, with the four Pareto-front models overlaid. The two exponential-$\eta $ models ($C = 14$, solid; $C = 16$, dashed) give the most balanced description of the data across all $\eta $ values, while the pure power-law-$\eta $ models ($C = 11$, dotted; $C = 17$, dot-dashed) deviate slightly and systematically at the ends of the $\eta $ range.\relax }}{99}{figure.caption.42}\protected@file@percent }
\newlabel{fig:pysr_benchmark_fits}{{42}{99}{The top \texttt {PySR} analytical models ($C = 11, 14, 16, 17$) compared with the lattice data for $\tAmp _{2B}^{\text {Re}}$ at fixed staple extents $\eta = 6, 7, 8, 10$ (with $P_1 = -1$ and $|\vect {b}| \geq 3a$). Each panel shows the amplitude as a function of the longitudinal separation $b_L/a$ at fixed transverse separations $b_T$, with the four Pareto-front models overlaid. The two exponential-$\eta $ models ($C = 14$, solid; $C = 16$, dashed) give the most balanced description of the data across all $\eta $ values, while the pure power-law-$\eta $ models ($C = 11$, dotted; $C = 17$, dot-dashed) deviate slightly and systematically at the ends of the $\eta $ range.\relax }{figure.caption.42}{}}
\newlabel{fig:pysr_benchmark_fits@cref}{{[figure][42][]42}{[1][98][]99}}
\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces Diagnostic straight-line test for the Gaussian hypothesis. If the amplitude followed a pure Gaussian profile $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text  {Re}} \propto e^{-c\,b^2}$, the data would appear as a straight line on a logarithmic ordinate versus $b^2$ (red dashed line, best Gaussian fit with $c = 0.058$). The lattice data (black markers) curve upward away from the Gaussian line at large $b^2$, indicating a heavier-than-Gaussian tail, which the \texttt  {PySR} power-law form $(1 + b^2)^{-1.39}$ (blue solid line) accurately captures. The curvature is direct, model-independent evidence that the spatial decay of the non-local quark bilinear follows an algebraic power law rather than a Gaussian exponential.\relax }}{100}{figure.caption.43}\protected@file@percent }
\newlabel{fig:gaussian_straightline_test}{{43}{100}{Diagnostic straight-line test for the Gaussian hypothesis. If the amplitude followed a pure Gaussian profile $\tAmp _{2B}^{\text {Re}} \propto e^{-c\,b^2}$, the data would appear as a straight line on a logarithmic ordinate versus $b^2$ (red dashed line, best Gaussian fit with $c = 0.058$). The lattice data (black markers) curve upward away from the Gaussian line at large $b^2$, indicating a heavier-than-Gaussian tail, which the \texttt {PySR} power-law form $(1 + b^2)^{-1.39}$ (blue solid line) accurately captures. The curvature is direct, model-independent evidence that the spatial decay of the non-local quark bilinear follows an algebraic power law rather than a Gaussian exponential.\relax }{figure.caption.43}{}}
\newlabel{fig:gaussian_straightline_test@cref}{{[figure][43][]43}{[1][98][]100}}
