\contentsline {table}{\numberline {17}{\ignorespaces Numerical Integration of Fourier Transforms: $P_L=-2, |b_T| = 3a \approx 0.34$ fm\relax }}{136}{table.caption.80}%
\contentsline {table}{\numberline {18}{\ignorespaces Simultaneous Fit with common $f$: for $P_L=-3$, $b_{min} \ge 3$, $\eta \in [6, 10]$. Global $\chi ^2/\text {DoF} = 0.712(66)$\relax }}{138}{table.caption.83}%
