\contentsline {table}{\numberline {28}{\ignorespaces All 34 $(P\cdot b, b^2)$ pairs available at $\eta |v|/a = 8$ and $P_L = -1$, where $P\cdot b = -P_L\,b_L$ and $b^2 = b_L^2 + b_T^2$. Grey entries fail the cut $|\ensuremath {\boldsymbol {b}}| \ge 3a$. Bold entries are the data used in the factorization test of Figure~\ref {fig:Factorization_ratios_Pb034_eta8_PL-1}.\relax }}{150}{table.caption.99}%
\contentsline {table}{\numberline {29}{\ignorespaces Origin of each grid value used in Figure~\ref {fig:Factorization_ratios_Pb034_eta8_PL-1}. ``Quad.\ $(b_1^2, b_2^2, b_3^2)$'' means the parabola in $b^2$ through the data at those three points on the same $P\cdot b$ row; ``lin.\ $[b_a^2, b_b^2]$'' means linear interpolation in $b^2$ between the data at $b_a^2$ and $b_b^2$. Where a cell has two entries, the upper one gives the linear points (circles) and the lower one the quadratic points (triangles) of Figure~\ref {fig:Factorization_ratios_Pb034_eta8_PL-1}. The pattern is the same for all three amplitudes.\relax }}{150}{table.caption.100}%
\contentsline {table}{\numberline {30}{\ignorespaces Comparison of the four factorized longitudinal-transverse models across nucleon momenta $P_L$, with extracted parameters shown at $P_L = -1$. While models with power-law transverse envelopes describe $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ passably, all four factorized ansatze fail on $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$.\relax }}{153}{table.caption.102}%
\contentsline {table}{\numberline {31}{\ignorespaces Numerical Integration of Fourier Transforms: $P_L=-4, |b_T| = 3a \approx 0.34$ fm, evaluated using the extrapolated ($\hat \zeta \to \infty $) amplitudes of Fig.~\ref {fig:extrapolated_amplitude_level_amps}, over the full range and three restricted $x$-ranges isolating the quark, antiquark, and combined contributions.\relax }}{161}{table.caption.108}%
\contentsline {table}{\numberline {32}{\ignorespaces Relative distance of the extrapolated Sivers shift $\langle k_y \rangle _{TU}(x,|b_T|)$ from its optimal factorized approximation $F(x)G(|b_T|)$, Eq.~\eqref {eq:factorization_relative_distance}, over $|b_T| \in [0.3421, 0.9403]$ fm for four choices of $x$-window.\relax }}{165}{table.caption.113}%
\contentsline {table}{\numberline {33}{\ignorespaces Relative distance of each extrapolated amplitude (and their combination $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{2B}-i\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Im}}_{2B}$) from its optimal factorized approximation, over the same $|b_T|\in [0.3421,0.9403]$ fm grid and $x$-windows as Table~\ref {tab:factorization_sivers}.\relax }}{168}{table.caption.119}%
