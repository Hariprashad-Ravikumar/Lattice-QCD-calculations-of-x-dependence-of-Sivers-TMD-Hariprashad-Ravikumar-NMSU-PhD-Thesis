\contentsline {table}{\numberline {1}{\ignorespaces Leading-twist quark TMDs, arranged by the polarization of the nucleon (rows) and of the quark (columns): unpolarized (U), longitudinally polarized (L) and transversely polarized (T). The Sivers function $f_{1T}^\perp $ and the Boer-Mulders function $h_1^\perp $ are naively T-odd.\relax }}{24}{table.caption.8}%
\contentsline {table}{\numberline {2}{\ignorespaces Resulting Collins-Soper parameters ($\hat {\zeta }$) and the necessary geometric constraint on the staple vector components to ensure the full $b \cdot P$ range is scanned.\relax }}{62}{table.caption.11}%
\contentsline {table}{\numberline {3}{\ignorespaces Configuration parameters for the Lattice QCD non-local matrix element extraction. Our lattice size is $\{\hat {L}^3\times \hat {T}\}=\{32^3\times 96\}$ and the lattice spacing is $a=0.11403\text { fm}$.\relax }}{63}{table.caption.12}%
\contentsline {table}{\numberline {4}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -1$. Empty brackets $\{\}$ denote a zero-length origin link, while numerical arrays (e.g., $\{1,3,1\}$) give the sequence of directional steps.\relax }}{65}{table.caption.15}%
\contentsline {table}{\numberline {5}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -2$.\relax }}{66}{table.caption.17}%
\contentsline {table}{\numberline {6}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -3$.\relax }}{67}{table.caption.19}%
\contentsline {table}{\numberline {7}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -4$.\relax }}{68}{table.caption.21}%
\contentsline {table}{\numberline {8}{\ignorespaces Discrete gauge link configurations for purely transverse quark separations ($\ensuremath {\boldsymbol {b}} = \{0, b_2, 0\}$). The numerical arrays show the sequential lattice steps (e.g., `2` represents a shift in the $x_2$ direction). Our lattice size is $\{\hat {L}^3\times \hat {T}\}=\{32^3\times 96\}$ and the lattice spacing is $a=0.11403\text { fm}$.\relax }}{73}{table.caption.25}%
\contentsline {table}{\numberline {9}{\ignorespaces Gauge link sequences for $+b_1$ (positive longitudinal separation). Symmetric sets of step-wise gauge link paths required to access finite $\pm b \cdot P$ and isolate the real and imaginary components of the invariant amplitudes. Our lattice size is $\{\hat {L}^3\times \hat {T}\}=\{32^3\times 96\}$ and the lattice spacing is $a=0.11403\text { fm}$.\relax }}{74}{table.caption.26}%
\contentsline {table}{\numberline {10}{\ignorespaces Mirrored gauge link sequences for $-b_1$ (negative longitudinal separation).Symmetric sets of step-wise gauge link paths required to access finite $\pm b \cdot P$ and isolate the real and imaginary components of the invariant amplitudes. Our lattice size is $\{\hat {L}^3\times \hat {T}\}=\{32^3\times 96\}$ and the lattice spacing is $a=0.11403\text { fm}$.\relax }}{75}{table.caption.27}%
\contentsline {table}{\numberline {11}{\ignorespaces Hyperparameter and operator configuration for the Physics-Informed \texttt {PySR} Symbolic Regression search.\relax }}{110}{table.caption.50}%
\contentsline {table}{\numberline {12}{\ignorespaces Pareto front of analytical candidate models discovered by \texttt {PySR} for the real amplitude $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}(\eta , b_L, b_T)$, ranked by mathematical complexity and loss. The optimal physics-informed models ($C=14$ and $C=16$) are highlighted.\relax }}{113}{table.caption.51}%
\contentsline {table}{\numberline {13}{\ignorespaces Separable fits of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ at $P_L=-1$ ($|\ensuremath {\boldsymbol {b}}|\ge 3a$, $6\le \eta \le 10$) with an exponential or Gaussian longitudinal profile in $P\cdot b$ and an exponential, Gaussian or power-law transverse profile. The Gaussian transverse profile gives a poor fit ($\chi ^2/\text {dof} \approx 4.98$). In the other models $c$ is consistent with zero within Jackknife uncertainties, so the fits show no longitudinal decay.\relax }}{118}{table.caption.55}%
\contentsline {table}{\numberline {14}{\ignorespaces Separable fits as in Table~\ref {tab:rejection_gaussian_transverse}, with an $\eta $-dependent longitudinal coefficient $c(\eta ) = c\,(1 - k_1/\eta + k_2/\eta ^2)$. The fitted $c$ is positive in every model, so $c(\eta )$ is positive as $\eta \to \infty $.\relax }}{119}{table.caption.56}%
\contentsline {table}{\numberline {15}{\ignorespaces 3D jackknife fits of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}(b_L,b_T,\eta )$ to a family of 16 Gaussian ans\"atze, all built on the common baseline $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}} = a\, e^{-f\eta }\, \exp \!\big [-c\,(b_L P_L)^2 - d\,(b_L^2+b_T^2)\big ]$, in which the coefficients $c$ and $d$ are each independently allowed to be either constant or one of three $\eta $-dependent forms, $c\to c(\eta )$ and/or $d\to d(\eta )$.\relax }}{120}{table.caption.57}%
\contentsline {table}{\numberline {16}{\ignorespaces 3D Jackknife fits of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}(b_L,b_T,\eta )$ to a family of power-law ans\"atze, all built on the common baseline $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}} = a\, e^{-f\eta }\, \left (1+(c+d)b^2_L+db^2_T\right )^{-j}$, in which the coefficient $c$ is either constant or one of several $\eta $-dependent forms, $c\to c(\eta )$.\relax }}{121}{table.caption.58}%
\contentsline {table}{\numberline {17}{\ignorespaces 3D jackknife fits of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}(b_L,b_T,\eta )$ to a family of power-law ans\"atze, all built on the common baseline $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}} = a\, e^{-f\eta }\, \left (1+(c+d)b^2_L+db^2_T\right )^{-j}$, in which the coefficient $c$ takes further $\eta $-dependent forms, $c\to c(\eta )$, that yield wider Fourier transforms in $x$ space.\relax }}{122}{table.caption.59}%
\contentsline {table}{\numberline {18}{\ignorespaces Sequential Lorentzian fits for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ at individual $\eta $ slices showing consistent $\chi ^2/\text {dof}$ and stable parameters.\relax }}{124}{table.caption.63}%
\contentsline {table}{\numberline {19}{\ignorespaces Sequential Lorentzian fits for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ at individual $\eta $ slices showing consistent $\chi ^2/\text {dof}$.\relax }}{125}{table.caption.65}%
\contentsline {table}{\numberline {20}{\ignorespaces Simultaneous Fit with common $f$: for $P_L=-1$, $b_{min} \ge 3$, $\eta \in [6, 10]$. Global $\chi ^2/\text {DoF} = 1.85(10)$\relax }}{129}{table.caption.67}%
