\contentsline {table}{\numberline {24}{\ignorespaces Simultaneous Fit with common $f$: for $P_L=-3$, $b_{min} \ge 3$, $\eta \in [6, 10]$. Global $\chi ^2/\text {DoF} = 0.712(66)$\relax }}{139}{table.caption.83}%
