\contentsline {table}{\numberline {9}{\ignorespaces Hyperparameter and operator configuration for the Physics-Informed \texttt {PySR} Symbolic Regression search.\relax }}{110}{table.caption.50}%
\contentsline {table}{\numberline {10}{\ignorespaces Pareto front of analytical candidate models discovered by \texttt {PySR} for the real amplitude $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}(\eta , b_L, b_T)$, ranked by mathematical complexity and loss. The optimal physics-informed models ($C=14$ and $C=16$) are highlighted.\relax }}{113}{table.caption.51}%
\contentsline {table}{\numberline {11}{\ignorespaces 3D jackknife fits of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}(b_L,b_T,\eta )$ to a family of 16 Gaussian ans\"atze, all built on the common baseline $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}} = a\, e^{-f\eta }\, \exp \!\big [-c\,(b_L P_L)^2 - d\,(b_L^2+b_T^2)\big ]$, in which the coefficients $c$ and $d$ are each independently allowed to be either constant or one of three $\eta $-dependent forms, $c\to c(\eta )$ and/or $d\to d(\eta )$.\relax }}{119}{table.caption.57}%
\contentsline {table}{\numberline {12}{\ignorespaces Sequential Lorentzian fits for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ at individual $\eta $ slices showing consistent $\chi ^2/\text {dof}$ and stable parameters.\relax }}{123}{table.caption.63}%
\contentsline {table}{\numberline {13}{\ignorespaces Sequential Lorentzian fits for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ at individual $\eta $ slices showing consistent $\chi ^2/\text {dof}$.\relax }}{124}{table.caption.65}%
\contentsline {table}{\numberline {14}{\ignorespaces Simultaneous Fit with common $f$: for $P_L=-1$, $b_{min} \ge 3$, $\eta \in [6, 10]$. Global $\chi ^2/\text {DoF} = 1.85(10)$\relax }}{128}{table.caption.67}%
