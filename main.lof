\contentsline {figure}{\numberline {28}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-2,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{68}{figure.caption.26}%
\contentsline {figure}{\numberline {29}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-2,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{68}{figure.caption.27}%
\contentsline {figure}{\numberline {30}{\ignorespaces $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-2,0,0\}$ at fixed $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space.\relax }}{69}{figure.caption.28}%
\contentsline {figure}{\numberline {31}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{70}{figure.caption.29}%
\contentsline {figure}{\numberline {32}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{70}{figure.caption.30}%
\contentsline {figure}{\numberline {33}{\ignorespaces $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$ at fixed $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space.\relax }}{71}{figure.caption.31}%
\contentsline {figure}{\numberline {34}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{72}{figure.caption.32}%
\contentsline {figure}{\numberline {35}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{72}{figure.caption.33}%
\contentsline {figure}{\numberline {36}{\ignorespaces $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$ at fixed $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space.\relax }}{73}{figure.caption.34}%
\contentsline {figure}{\numberline {37}{\ignorespaces Failure of Gaussian model fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$ (with $\alpha -\beta = -0.0427(27)$ and $\chi ^2/\text {dof}\approx 235$) and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ (with $\alpha -\beta = -0.022(25)$ and $\chi ^2/\text {dof}\approx 1.4$) amplitudes.\relax }}{75}{figure.caption.35}%
\contentsline {figure}{\numberline {38}{\ignorespaces Plots of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$ amplitude showing the short-distance data ($|\ensuremath {\boldsymbol {b}}| < 3a$) exhibiting an opposite curvature compared to the long-distance data ($|\ensuremath {\boldsymbol {b}}| \ge 3a$) for fixed momentum ($P=-1$) and fixed $\eta $ (say $\eta =8$)\relax }}{77}{figure.caption.36}%
\contentsline {figure}{\numberline {39}{\ignorespaces Plots of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitude showing the short-distance data ($|\ensuremath {\boldsymbol {b}}| < 3a$) exhibiting an opposite curvature compared to the long-distance data ($|\ensuremath {\boldsymbol {b}}| \ge 3a$) for fixed momentum ($P=-1$) and fixed $\eta $ (say $\eta =8$)\relax }}{77}{figure.caption.37}%
\contentsline {figure}{\numberline {40}{\ignorespaces Multi-panel comparison of the top \texttt {PySR}-discovered analytical models ($C = 11, 14, 16, 17$) against the lattice data for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ at fixed staple extents $\eta = 6, 7, 8, 10$ (with $P_1 = -1$ and $|\ensuremath {\boldsymbol {b}}| \geq 3a$). Each panel displays the amplitude as a function of the longitudinal separation $b_L/a$ at fixed transverse separations $b_T$, with the four Pareto-front models overlaid. The two exponential-$\eta $ models ($C = 14$, solid; $C = 16$, dashed) provide the most balanced description across all $\eta $ values, while the pure power-law-$\eta $ models ($C = 11$, dotted; $C = 17$, dot-dashed) exhibit slight systematic deviations at the extremes of the $\eta $ range.\relax }}{82}{figure.caption.40}%
\contentsline {figure}{\numberline {41}{\ignorespaces Diagnostic straight-line test for the Gaussian hypothesis. If the amplitude followed a pure Gaussian profile $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}} \propto e^{-c\,b^2}$, the data would appear as a straight line on a logarithmic ordinate versus $b^2$ (red dashed line, optimal Gaussian fit with $c = 0.058$). The lattice data (black markers) exhibit clear upward curvature away from the Gaussian baseline at large $b^2$, indicating a heavier-than-Gaussian tail that is accurately captured by the \texttt {PySR}-discovered power-law form $(1 + b^2)^{-1.39}$ (blue solid line). This provides direct, model-independent evidence that the spatial decay of the non-local quark bilinear follows an algebraic power law rather than a Gaussian exponential.\relax }}{83}{figure.caption.41}%
\contentsline {figure}{\numberline {42}{\ignorespaces Factorization ratio test at $\eta |v|/a = 8$, $P_L = -1$ ($\hat {\zeta } = 0.090772$) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$. Top row: $T(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_T}, the ratio to the $P\cdot b = 4$ row, plotted against $b^2$. Bottom row: $B(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_B}, the ratio to $b^2 = 18$, plotted against $P\cdot b$. Under factorization every set of points is flat. Values off the data points are obtained by linear interpolation in $b^2$ (Table~\ref {tab:factorization_grid}). Error bars are Jackknife errors and do not include any uncertainty from the interpolation.\relax }}{86}{figure.caption.44}%
\contentsline {figure}{\numberline {43}{\ignorespaces 3D jackknife fits of $\mathrm {Re}\,\tilde {A}_{2B}(b_L,b_T,\eta )$ to a family of 16 Gaussian ans\"atze, all built on the common baseline $\tilde {A}_{2B} = a\, e^{-f\eta }\, \exp \!\big [-c\,(b_L P_L)^2 - d\,(b_L^2+b_T^2)\big ]$, in which the coefficients $c$ and $d$ are each independently allowed to be either constant or one of three $\eta $-dependent forms, $c\to c(\eta )$ and/or $d\to d(\eta )$.\relax }}{87}{figure.caption.45}%
\contentsline {figure}{\numberline {44}{\ignorespaces 3D Jackknife fits of $\mathrm {Re}\,\tilde {A}_{2B}(b_L,b_T,\eta )$ to a family of power-law ans\"atze, all built on the common baseline $\tilde {A}_{2B} = a\, e^{-f\eta }\, \left (1+(c+d)b^2_L+db^2_T\right )^j$, in which the coefficient $c$ is each independently allowed to be either constant or one of $\eta $-dependent forms, $c\to c(\eta )$.\relax }}{88}{figure.caption.46}%
\contentsline {figure}{\numberline {45}{\ignorespaces 3D jackknife fits of $\mathrm {Re}\,\tilde {A}_{2B}(b_L,b_T,\eta )$ to a family of power-law ans\"atze, all built on the common baseline $\tilde {A}_{2B} = a\, e^{-f\eta }\, \left (1+(c+d)b^2_L+db^2_T\right )^j$, in which the coefficient $c$ is each independently allowed to $\eta $-dependent forms, $c\to c(\eta )$ which yield wider Fourier transforms in $x$ space.\relax }}{89}{figure.caption.47}%
\contentsline {figure}{\numberline {46}{\ignorespaces Sequential Lorentzian fits for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$ at individual $\eta $ slices, holding the global power $j=2$ and amplitude $a=4$ constant.\relax }}{90}{figure.caption.48}%
\contentsline {figure}{\numberline {47}{\ignorespaces The extracted parameter $c(\eta )$ overlaid with various candidate asymptotic models, demonstrating its asymptotic approach at large $\eta $.\relax }}{90}{figure.caption.49}%
\contentsline {figure}{\numberline {48}{\ignorespaces The extracted parameter $d(\eta )$, exhibiting a clear independence from the staple extent $\eta $.\relax }}{90}{figure.caption.50}%
\contentsline {figure}{\numberline {49}{\ignorespaces Lattice extracted parameters $c$ (left) and $d$ (right) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ as a function of $\eta $. Both parameters demonstrate clear independence from $\eta $.\relax }}{92}{figure.caption.52}%
\contentsline {figure}{\numberline {50}{\ignorespaces Lattice extracted parameters $c$ (left) and $d$ (right) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ as a function of $\eta $. Despite increased statistical noise, the data are highly consistent with the constant-parameter ansatz.\relax }}{92}{figure.caption.54}%
\contentsline {figure}{\numberline {51}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{96}{figure.caption.56}%
\contentsline {figure}{\numberline {52}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{97}{figure.caption.57}%
\contentsline {figure}{\numberline {53}{\ignorespaces 2D representation of the full Jackknife covariance matrix used in the simultaneous fit for $P_1=-1$. The prominent off-diagonal bands show the strong correlations across the parameter space.\relax }}{98}{figure.caption.59}%
\contentsline {figure}{\numberline {54}{\ignorespaces 3D surface plot of the Jackknife covariance matrix for $P_1=-1$, visually emphasizing the magnitude of the cross-correlations between the real and imaginary amplitude components.\relax }}{99}{figure.caption.60}%
\contentsline {figure}{\numberline {55}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-2,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{100}{figure.caption.62}%
\contentsline {figure}{\numberline {56}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-2,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{101}{figure.caption.63}%
\contentsline {figure}{\numberline {57}{\ignorespaces 2D representation of the full Jackknife covariance matrix used in the simultaneous fit for $P_L=-2$.\relax }}{102}{figure.caption.65}%
\contentsline {figure}{\numberline {58}{\ignorespaces 3D surface plot of the Jackknife covariance matrix for $P_L=-2$.\relax }}{102}{figure.caption.66}%
\contentsline {figure}{\numberline {59}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{103}{figure.caption.68}%
\contentsline {figure}{\numberline {60}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{104}{figure.caption.69}%
\contentsline {figure}{\numberline {61}{\ignorespaces 2D representation of the full Jackknife covariance matrix used in the simultaneous fit for $P_L=-3$.\relax }}{105}{figure.caption.71}%
\contentsline {figure}{\numberline {62}{\ignorespaces 3D surface plot of the Jackknife covariance matrix for $P_L=-3$.\relax }}{106}{figure.caption.72}%
\contentsline {figure}{\numberline {63}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{107}{figure.caption.74}%
\contentsline {figure}{\numberline {64}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{108}{figure.caption.75}%
\contentsline {figure}{\numberline {65}{\ignorespaces 2D representation of the full Jackknife covariance matrix used in the simultaneous fit for $P_L=-4$.\relax }}{109}{figure.caption.77}%
\contentsline {figure}{\numberline {66}{\ignorespaces 3D surface plot of the Jackknife covariance matrix for $P_L=-4$.\relax }}{109}{figure.caption.78}%
\contentsline {figure}{\numberline {67}{\ignorespaces Fit results testing the validity of the separability hypothesis: an exponential decay in $(P\cdot b)$ is paired with a Gaussian transverse profile; the fit is poor ($\chi ^2/\text {dof} \approx 4.98$). In models that achieve a lower $\chi ^2/\text {dof}$, the coefficient $c$ consistently fits to zero within uncertainties and is negative in each Jackknife set, demonstrating that the data rejects the separability hypothesis.\relax }}{110}{figure.caption.79}%
\contentsline {figure}{\numberline {68}{\ignorespaces Fit results testing the validity of the separability hypothesis with $\eta $-dependent $c$, as $c(\eta )$. In models that achieve a lower $\chi ^2/\text {dof}$, the coefficient $c$ is now positive\relax }}{111}{figure.caption.80}%
\contentsline {figure}{\numberline {69}{\ignorespaces Discrete $\hat \zeta $-slices of the reconstructed amplitudes, unpolarized and Sivers TMD combinations, and Sivers shift, plotted against both $x$ and $1/\hat \zeta $ at fixed transverse separation $|b_T| = 3a \approx 0.34$ fm. Each ribbon corresponds to one of the four simulated momenta $P_L = -1,-2,-3,-4$ (equivalently $1/\hat \zeta = 11.02,\ 3.40,\ 1.85,\ 1.27$). The systematic drift of every panel with $1/\hat \zeta $ motivates the extrapolation to the physical light-cone limit $\hat \zeta \to \infty $ performed below.\relax }}{115}{figure.caption.82}%
\contentsline {figure}{\numberline {70}{\ignorespaces Extrapolation of the twelve simultaneous-fit parameters to the physical limit $\hat \zeta \to \infty $, using only the three higher momenta $P_L=-2,-3,-4$ (black points, plotted against $1/\hat \zeta $). The dashed red curve and shaded band show the fitted ansatz $c+d/\hat \zeta ^2$ of Eq.~\ref {eq:zetahat_extrap_ansatz}, with each panel's Jackknife $\chi ^2/\text {dof}$ noted in its title; the blue square at $1/\hat \zeta =0$ marks the extrapolated physical-limit value. The parameters $c_{\text {re}}$, $c_{\text {im}}$, and $c_{\text {reA12B}}$ are shown rescaled by $1/P_L^2$, and $a_{\text {im}}$ by $1/P_L$, as described in the text.\relax }}{116}{figure.caption.83}%
\contentsline {figure}{\numberline {71}{\ignorespaces Unpolarized and Sivers TMD amplitudes reconstructed from the extrapolated ($\hat \zeta \to \infty $) fit parameters of Fig.~\ref {fig:param_extrapolation_zetahat}, evaluated as continuous functions of $x$ at fixed transverse separation $|b_T| = 3a \approx 0.34$ fm: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$, $i\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$, the full unpolarized combination $\tilde f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$, the Sivers combination $\tilde f_1^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$, and the resulting Sivers shift $\langle k_y \rangle _{TU}$ and $x\langle k_y \rangle _{TU}$, the latter two restricted to the quark region $x\ge 0$. Shaded bands are the Jackknife uncertainty propagated from the twelve extrapolated parameters.\relax }}{116}{figure.caption.84}%
\contentsline {figure}{\numberline {72}{\ignorespaces The same six extrapolated ($\hat \zeta \to \infty $) quantities as Fig.~\ref {fig:extrapolated_amplitude_level}, shown here as full surfaces in $x$ and transverse separation $|b_T|$ (ranging from $3a\approx 0.34$ fm to $\sqrt {68}\,a\approx 0.94$ fm). The joint $x$-$|b_T|$ dependence illustrates how the reconstructed amplitudes and the extracted Sivers shift evolve with transverse quark separation at the physical limit.\relax }}{118}{figure.caption.86}%
\contentsline {figure}{\numberline {73}{\ignorespaces Comparison, at fixed $|b_T| = 3a \approx 0.34$ fm, between the six physical quantities evaluated at each of the three finite momenta used in the extrapolation ($P_L=-2,-3,-4$, colored curves, each using its own unextrapolated fit parameters) and the extrapolated $\hat \zeta \to \infty $ result (black dashed curve). The extrapolated curve is distinct from all three finite-momentum curves rather than coinciding with the largest simulated momentum, confirming that the fit-parameter extrapolation of Fig.~\ref {fig:param_extrapolation_zetahat} captures genuine momentum dependence rather than simply reproducing the $P_L=-4$ result.\relax }}{119}{figure.caption.87}%
\contentsline {figure}{\numberline {74}{\ignorespaces Left and center: the optimal separable factors $g(x)$ and $h(|b_T|)$ (Eqs.~\eqref {eq:factorization_h_solution}-\eqref {eq:factorization_g_selfconsistent}, normalized so $\text {mean}[g^2]=1$) for the extrapolated Sivers shift, shown for all four $x$-windows of Table~\ref {tab:factorization_sivers}. Right: the reconstructed $g(x)h(|b_T|)$ (dashed) compared to the actual extrapolated Sivers shift (solid) at the smallest and largest fitted $|b_T|$, using the $x\in [0,1]$ fit; the visible gap between the solid and dashed curves is the residual quantified in Table~\ref {tab:factorization_sivers}.\relax }}{121}{figure.caption.89}%
\contentsline {figure}{\numberline {75}{\ignorespaces $R_b(x) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(x,0.34\text { fm})$ for four values of $|b_T|$, as a function of $x$. Under exact factorization each curve would be flat; instead every curve rises from its $x\to 0$ value to a peak near $x\approx 0.1$ before decaying, showing that the $|b_T|$-dependence of the Sivers shift is itself $x$-dependent.\relax }}{122}{figure.caption.90}%
\contentsline {figure}{\numberline {76}{\ignorespaces $R_x(|b_T|) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(0.3,|b_T|)$ for four values of $x$, as a function of $|b_T|$. The $x=0.2$ curve varies by more than a factor of two across the fitted $|b_T|$ range rather than remaining flat, confirming that the $x$-dependence of the Sivers shift is itself $|b_T|$-dependent, consistent with Fig.~\ref {fig:factorization_ratio_x_sivers}.\relax }}{123}{figure.caption.91}%
\contentsline {figure}{\numberline {77}{\ignorespaces The same ratio test as Fig.~\ref {fig:factorization_ratio_x_sivers}, $R_b(x)$, repeated at each finite momentum individually using its own raw (unextrapolated) fit parameters. None of the four panels shows a flat curve, confirming that the non-factorization is a genuine feature of the fitted amplitudes rather than an artifact of the $\hat \zeta \to \infty $ extrapolation.\relax }}{124}{figure.caption.92}%
\contentsline {figure}{\numberline {78}{\ignorespaces The same ratio test as Fig.~\ref {fig:factorization_ratio_bT_sivers}, $R_x(|b_T|)$, repeated at each finite momentum individually. The departure from flatness grows with $|P_L|$, most visibly in the $x=0.2$ curve, which is consistent with the parameter mismatch identified in the extrapolated $j_X$ and $d_X$ values above.\relax }}{125}{figure.caption.93}%
\contentsline {figure}{\numberline {79}{\ignorespaces Optimal separable factor $g(x)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows (normalized so $\text {mean}[g^2]=1$). Each amplitude's $g(x)$ is dominated by a sharp rise as $x\to 0$ that steepens as the window narrows, reflecting the Bessel-function behavior at small $x$.\relax }}{126}{figure.caption.95}%
\contentsline {figure}{\numberline {80}{\ignorespaces Optimal separable factor $h(|b_T|)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows. All four amplitudes' $h(|b_T|)$ fall smoothly with increasing $|b_T|$, but with a magnitude and slope that depends on the $x$-window used to define the fit, itself a signature of imperfect factorization.\relax }}{127}{figure.caption.96}%
\contentsline {figure}{\numberline {81}{\ignorespaces Reconstructed $g(x)h(|b_T|)$ (dashed) against the actual extrapolated amplitude data (solid) at the smallest and largest fitted $|b_T|$, using the $x\in [0,1]$ fit, for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}. The largest reconstruction gap appears near $x\to 0$ for every amplitude, matching the $x\in [0,1]$ column of Table~\ref {tab:factorization_amplitudes} being the largest relative distance in every row.\relax }}{128}{figure.caption.97}%
