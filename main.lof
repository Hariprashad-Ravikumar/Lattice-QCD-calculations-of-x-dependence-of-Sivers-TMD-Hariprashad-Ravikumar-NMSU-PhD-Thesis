\contentsline {figure}{\numberline {1}{\ignorespaces Directions of the spatial staple vectors $\ensuremath {\boldsymbol {v}}$ mapped in the $v_1-v_3$ plane. Each vector corresponds to the requisite geometry to satisfy the $b \cdot P \neq 0$ constraint for the four sequential Collins-Soper parameters $\hat {\zeta }$.\relax }}{17}{figure.caption.6}%
\contentsline {figure}{\numberline {2}{\ignorespaces Ideal continuous trajectory of the off-axis staple vector (solid blue) for $P_1 = -1$. Circular markers indicate target continuous coordinates for sequential values of $\eta $. Dashed lines illustrate the discrete, step-wise permutations of gauge links used to reach the surrounding bounding integer lattice sites.\relax }}{19}{figure.caption.7}%
\contentsline {figure}{\numberline {3}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -1$. Empty brackets $\{\}$ denote a zero-length origin link, while numerical arrays (e.g., $\{1,3,1\}$) explicitly dictate the sequential directional steps.\relax }}{19}{figure.caption.7}%
\contentsline {figure}{\numberline {4}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -2$.\relax }}{19}{figure.caption.8}%
\contentsline {figure}{\numberline {5}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -2$.\relax }}{19}{figure.caption.8}%
\contentsline {figure}{\numberline {6}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -3$.\relax }}{19}{figure.caption.9}%
\contentsline {figure}{\numberline {7}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -3$.\relax }}{19}{figure.caption.9}%
\contentsline {figure}{\numberline {8}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -4$.\relax }}{20}{figure.caption.10}%
\contentsline {figure}{\numberline {9}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -4$.\relax }}{20}{figure.caption.10}%
\contentsline {figure}{\numberline {10}{\ignorespaces Illustration of path degeneracy. Two distinct step-wise gauge link permutations (e.g., solid and dashed lines) terminate at the identical discrete lattice coordinate. The correlators from these equivalent paths are averaged to suppress local gauge noise prior to interpolation.\relax }}{20}{figure.caption.11}%
\contentsline {figure}{\numberline {11}{\ignorespaces Quadratic interpolation of the real and imaginary parts of the correlation function for $\ensuremath {\boldsymbol {b}}=\{1,2,0\}$, $\eta =7$, and $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=(-1,0,0)$. Red markers indicate the path-averaged lattice data points as a function of their deviation from the ideal constraint trajectory, $\Delta v_1 = (v_1^{\text {constraint}} - v_1^{\text {lattice}})/a$. The gray band indicates the quadratic fit (`InterpolationOrder $\rightarrow $ 2`), and the central blue marker represents the final extracted value at $\Delta v_1 = 0$, lying exactly on the required off-axis spatial trajectory.\relax }}{22}{figure.caption.12}%
\contentsline {figure}{\numberline {12}{\ignorespaces The sampled operator separation vectors mapped in the spatial $b_1-b_2$ plane (where $b_1 \equiv b_L$ and $b_2 \equiv b_T$).\relax }}{24}{figure.caption.13}%
\contentsline {figure}{\numberline {13}{\ignorespaces Mapping of the spatial lattice vectors into the physical invariant Variable Space $(b \cdot P/(2\pi ), |b|/a)$. The trajectories diverge based on the selected target $\hat {\zeta }$.\relax }}{24}{figure.caption.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Coverage of the quark separation vectors across the simulated lattice volume and their corresponding physical Variable Space representation.\relax }}{24}{figure.caption.13}%
\contentsline {figure}{\numberline {15}{\ignorespaces Discrete gauge link configurations for strictly transverse quark separations ($\ensuremath {\boldsymbol {b}} = \{0, b_2, b_3\}$). Numerical arrays dictate the sequential lattice steps (e.g., `2` represents a shift in the $x_2$ direction).\relax }}{24}{figure.caption.14}%
\contentsline {figure}{\numberline {16}{\ignorespaces Gauge link sequences for $+b_1$ (positive longitudinal separation).\relax }}{26}{figure.caption.15}%
\contentsline {figure}{\numberline {17}{\ignorespaces Mirrored gauge link sequences for $-b_1$ (negative longitudinal separation).\relax }}{26}{figure.caption.15}%
\contentsline {figure}{\numberline {18}{\ignorespaces Symmetric sets of step-wise gauge link paths required to access finite $\pm b \cdot P$ and isolate the real and imaginary components of the invariant amplitudes.\relax }}{26}{figure.caption.15}%
\contentsline {figure}{\numberline {19}{\ignorespaces Illustration of path degeneracy for the quark separation vector $\ensuremath {\boldsymbol {b}}$. Distinct step-wise permutations (solid and dashed lines) terminating at the same Cartesian coordinate are averaged to suppress local gauge noise.\relax }}{27}{figure.caption.16}%
\contentsline {figure}{\numberline {20}{\ignorespaces The full network of path-averaged $\ensuremath {\boldsymbol {b}}$ vectors in the $b_1/a - b_2/a$ plane. Solid red lines represent the ideal vectors, while dashed lines illustrate the underlying degenerate staircase paths calculated and averaged on the discrete lattice.\relax }}{27}{figure.caption.17}%
\contentsline {figure}{\numberline {21}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{42}{figure.caption.18}%
\contentsline {figure}{\numberline {22}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{42}{figure.caption.19}%
