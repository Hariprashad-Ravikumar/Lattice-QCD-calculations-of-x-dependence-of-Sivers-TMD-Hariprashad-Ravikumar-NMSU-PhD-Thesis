\contentsline {figure}{\numberline {28}{\ignorespaces Same as Fig.~\ref {fig:A2B_eta8_P1}, but for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$ ($\hat {\zeta }=0.539684$).\relax }}{97}{figure.caption.40}%
