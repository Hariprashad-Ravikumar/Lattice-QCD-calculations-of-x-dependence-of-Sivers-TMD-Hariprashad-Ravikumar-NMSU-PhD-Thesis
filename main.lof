\contentsline {figure}{\numberline {1}{\ignorespaces Relations between the distributions that describe the quark structure of the nucleon. Integrating the generalized TMDs (or their Fourier transforms, the Wigner distributions) over transverse position gives TMDs, and integrating over transverse momentum gives GPDs. The collinear PDFs are obtained from TMDs by integrating over $\ensuremath {\boldsymbol {k}}_{\mathrm T}$ and from GPDs in the forward limit. Moments of GPDs in $x$ give the elastic form factors.\relax }}{3}{figure.caption.4}%
\contentsline {figure}{\numberline {2}{\ignorespaces Schematic picture of the Sivers effect. For a nucleon moving into the page ($\ensuremath {\boldsymbol {P}}$ along $\hat {\ensuremath {\boldsymbol {z}}}$) with transverse spin $\ensuremath {\boldsymbol {S}}_{\mathrm T}$ along $\hat {\ensuremath {\boldsymbol {y}}}$, the second term of Eq.~\eqref {eq:intro_sivers_density} becomes $-\,k_x f_{1T}^\perp /m_N$. A nonzero Sivers function therefore shifts the density of unpolarized quarks along $\hat {\ensuremath {\boldsymbol {x}}}$, perpendicular to both $\ensuremath {\boldsymbol {P}}$ and $\ensuremath {\boldsymbol {S}}_{\mathrm T}$ (solid circle), relative to the symmetric unpolarized distribution (dashed). The shift shown, toward $+\hat {\ensuremath {\boldsymbol {x}}}$, corresponds to $f_{1T}^\perp <0$.\relax }}{5}{figure.caption.5}%
\contentsline {figure}{\numberline {3}{\ignorespaces Handbag diagram for the leading contribution to the DIS hadronic tensor. The virtual photon scatters off a quark of momentum $k$ with $k^+ = xP^+$, and the lower blob is the quark-quark correlator whose $\gamma ^+$ projection gives the PDF $f_1(x)$. The dashed line indicates the sum over final states.\relax }}{18}{figure.caption.6}%
\contentsline {figure}{\numberline {4}{\ignorespaces Staple-shaped gauge links connecting the quark fields at $0$ and $b$ in the TMD correlator, Eq.~\eqref {eq:tmd_correlator_simple}. (a) In SIDIS the link runs to $+\infty $ along the light-cone direction $\ensuremath {n}$ of the outgoing quark, Eq.~\eqref {eq:staple_sidis}. (b) In Drell-Yan it runs to $-\infty $, Eq.~\eqref {eq:staple_dy}. The dashed segment is the transverse link at infinity. In the lattice calculation the legs have finite length $\eta |v|$ along a space-like direction $v$, and the two cases correspond to $\eta v{\cdot }P\to +\infty $ and $\eta v{\cdot }P\to -\infty $ \cite {Musch:2011er}.\relax }}{23}{figure.caption.7}%
\contentsline {figure}{\numberline {5}{\ignorespaces Quark fields $\psi (x)$ and $\psi (x+a\hat \mu )$ on the sites of a cubic spacetime lattice, the link variable $U_\mu (x)$ between them, and the plaquette $P_{\mu \nu }(y)$ of Eq.~\eqref {eq:plaquette}. The product $U_\mu (x)\psi (x+a\hat \mu )$ transforms in the same way as $\psi (x)$. Reproduced from Ref.~\cite {Lin:2014}, Fig.~1.1.\relax }}{34}{figure.caption.9}%
\contentsline {figure}{\numberline {6}{\ignorespaces Staple-shaped gauge link (\cite {BMush_Engelhardt2012}) as in SIDIS and DY.\relax }}{49}{figure.caption.10}%
\contentsline {figure}{\numberline {7}{\ignorespaces Directions of the spatial staple vectors $\ensuremath {\boldsymbol {v}}$ mapped in the $v_1-v_3$ plane. Each vector corresponds to the requisite geometry to satisfy the $b \cdot P \neq 0$ constraint for the four sequential Collins-Soper parameters $\hat {\zeta }$.\relax }}{63}{figure.caption.13}%
\contentsline {figure}{\numberline {8}{\ignorespaces Ideal continuous trajectory of the off-axis staple vector (solid blue) for $P_1 = -1$. Circular markers indicate target continuous coordinates for sequential values of $\eta $. Dashed lines illustrate the discrete, step-wise permutations of gauge links used to reach the surrounding bounding integer lattice sites.\relax }}{65}{figure.caption.14}%
\contentsline {figure}{\numberline {9}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -2$.\relax }}{66}{figure.caption.16}%
\contentsline {figure}{\numberline {10}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -3$.\relax }}{67}{figure.caption.18}%
\contentsline {figure}{\numberline {11}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -4$.\relax }}{68}{figure.caption.20}%
\contentsline {figure}{\numberline {12}{\ignorespaces Illustration of path degeneracy. Two distinct step-wise gauge link permutations (e.g., solid and dashed lines) terminate at the identical discrete lattice coordinate. We average the correlators from these equivalent paths to suppress local gauge noise before interpolation.\relax }}{69}{figure.caption.22}%
\contentsline {figure}{\numberline {13}{\ignorespaces Quadratic interpolation of the real and imaginary parts of the correlation function for $\ensuremath {\boldsymbol {b}}=\{1,2,0\}$, $\eta =7$, and $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=(-1,0,0)$. Red markers indicate the path-averaged lattice data points as a function of their deviation from the ideal constraint trajectory, $\Delta v_1 = (v_1^{\text {constraint}} - v_1^{\text {lattice}})/a$. The gray band indicates the quadratic fit (`InterpolationOrder $\rightarrow $ 2`), and the central blue marker represents the final extracted value at $\Delta v_1 = 0$, lying exactly on the required off-axis spatial trajectory.\relax }}{71}{figure.caption.23}%
\contentsline {figure}{\numberline {14}{\ignorespaces The sampled operator separation vectors mapped in the spatial $b_1-b_2$ plane (where $b_1 \equiv b_L$ and $b_2 \equiv b_T$).\relax }}{72}{figure.caption.24}%
\contentsline {figure}{\numberline {15}{\ignorespaces Mapping of the spatial lattice vectors into the physical invariant Variable Space $(b \cdot P/(2\pi ), |b|/a)$. The trajectories diverge based on the selected target $\hat {\zeta }$.\relax }}{72}{figure.caption.24}%
\contentsline {figure}{\numberline {16}{\ignorespaces Illustration of path degeneracy for the quark separation vector $\ensuremath {\boldsymbol {b}}$. Distinct step-wise permutations (solid and dashed lines) terminating at the same Cartesian coordinate are averaged to suppress local gauge noise.\relax }}{76}{figure.caption.28}%
\contentsline {figure}{\numberline {17}{\ignorespaces The full network of path-averaged $\ensuremath {\boldsymbol {b}}$ vectors in the $b_1/a - b_2/a$ plane. Solid red lines represent the ideal vectors, while dashed lines illustrate the underlying degenerate staircase paths calculated and averaged on the discrete lattice.\relax }}{76}{figure.caption.29}%
\contentsline {figure}{\numberline {18}{\ignorespaces Real (top 2 rows) and imaginary (bottom 2 rows) parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The first row of each 2-row block displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the second row of each 2-row block displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{87}{figure.caption.30}%
\contentsline {figure}{\numberline {19}{\ignorespaces Real (top 2 rows) and imaginary (bottom 2 rows) parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The first row of each 2-row block displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the second row of each 2-row block displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{88}{figure.caption.31}%
\contentsline {figure}{\numberline {20}{\ignorespaces Real (top 2 rows) and imaginary (bottom 2 rows) parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$ at fixed $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The first row of each 2-row block displays the $(b_{L}/a,b_{T}/a)-$space, while the second row of each 2-row block displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space.\relax }}{89}{figure.caption.32}%
\contentsline {figure}{\numberline {21}{\ignorespaces Real (top 2 rows) and imaginary (bottom 2 rows) parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$ at fixed $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The first row of each 2-row block displays the $(b_{L}/a,b_{T}/a)-$space, while the second row of each 2-row block displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space. Notice the lack of discernible signal in $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Im}}$.\relax }}{90}{figure.caption.33}%
\contentsline {figure}{\numberline {22}{\ignorespaces Same as Fig.~\ref {fig:A2B_amplitudes_P1}, but for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-2,0,0\}$ ($\hat {\zeta }=0.294367$).\relax }}{91}{figure.caption.34}%
