\contentsline {figure}{\numberline {58}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{139}{figure.caption.84}%
\contentsline {figure}{\numberline {59}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{140}{figure.caption.85}%
\contentsline {figure}{\numberline {60}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{140}{figure.caption.86}%
\contentsline {figure}{\numberline {61}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-3,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{141}{figure.caption.87}%
\contentsline {figure}{\numberline {62}{\ignorespaces $x$-dependence at $b^2=9a^2$ for $P_L=-2$. Top row: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{2B}$, $i\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Im}}_{2B}$, and $\tilde f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]}_{2B}$. Bottom row: $\tilde f_{1T}^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{12B}$, $\langle k_y\rangle _{TU}$, and $x\langle k_y\rangle _{TU}$. Bands show the Jackknife uncertainty.\relax }}{143}{figure.caption.89}%
\contentsline {figure}{\numberline {63}{\ignorespaces The quantities of Figure~\ref {fig:ft_xdep_2d_P3} as functions of $x$ and $b^2/a^2\in [9,68]$ for $P_L=-2$.\relax }}{143}{figure.caption.90}%
\contentsline {figure}{\numberline {64}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{144}{figure.caption.92}%
\contentsline {figure}{\numberline {65}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{145}{figure.caption.93}%
\contentsline {figure}{\numberline {66}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{145}{figure.caption.94}%
\contentsline {figure}{\numberline {67}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{146}{figure.caption.95}%
\contentsline {figure}{\numberline {68}{\ignorespaces $x$-dependence at $b^2=9a^2$ for $P_L=-2$. Top row: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{2B}$, $i\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Im}}_{2B}$, and $\tilde f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]}_{2B}$. Bottom row: $\tilde f_{1T}^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{12B}$, $\langle k_y\rangle _{TU}$, and $x\langle k_y\rangle _{TU}$. Bands show the Jackknife uncertainty.\relax }}{148}{figure.caption.97}%
\contentsline {figure}{\numberline {69}{\ignorespaces The quantities of Figure~\ref {fig:ft_xdep_2d_P4} as functions of $x$ and $b^2/a^2\in [9,68]$ for $P_L=-2$.\relax }}{148}{figure.caption.98}%
\contentsline {figure}{\numberline {70}{\ignorespaces Factorization ratio test at $\eta |v|/a = 8$, $P_L = -1$ ($\hat {\zeta } = 0.090772$) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$. Top row: $T(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_T}, the ratio to the $P\cdot b = 4$ row, plotted against $b^2$. Bottom row: $B(P\cdot b, b^2)$ of Eq.~\eqref {eq:factorization_B}, the ratio to $b^2 = 18$, plotted against $P\cdot b$. Under factorization, every set of points is flat. Filled circles use linear interpolation in $b^2$ on all three rows. Open triangles use quadratic interpolation on the $P\cdot b = 0$ and $4$ rows and linear interpolation on the $P\cdot b = 3$ row (Table~\ref {tab:factorization_grid}). A triangle is omitted where both schemes give the same value, which happens for every point that involves only the $P\cdot b = 3$ row and data points. Error bars are Jackknife errors and do not include any uncertainty from the interpolation.\relax }}{151}{figure.caption.101}%
\contentsline {figure}{\numberline {71}{\ignorespaces Discrete $\hat \zeta $-slices of the reconstructed amplitudes $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{2B}$ and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Im}}_{2B}$ and the unpolarized and Sivers TMD combinations $\tilde f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]}_{2B}$ and $\tilde f_{1T}^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{12B}$, plotted against both $x$ and $1/\hat \zeta $ at fixed transverse separation $|b_T| = 3a \approx 0.34$ fm. Each ribbon corresponds to one of the four simulated momenta $P_L = -1,-2,-3,-4$ (equivalently $1/\hat \zeta = 11.02,\ 3.40,\ 1.85,\ 1.27$). The systematic drift of every panel with $1/\hat \zeta $ motivates the extrapolation to the physical light-cone limit $\hat \zeta \to \infty $ performed below.\relax }}{157}{figure.caption.103}%
\contentsline {figure}{\numberline {72}{\ignorespaces Sivers shift $\langle k_y \rangle _{TU}$ and $x\langle k_y \rangle _{TU}$ for the same four momenta and the same $|b_T|$ as Fig.~\ref {fig:zetahat_discrete_slices_amps}, restricted to the quark region $x\ge 0$.\relax }}{157}{figure.caption.104}%
\contentsline {figure}{\numberline {73}{\ignorespaces Extrapolation of the twelve simultaneous-fit parameters to the physical limit $\hat \zeta \to \infty $, using only the three higher momenta $P_L=-2,-3,-4$ (black points, plotted against $1/\hat \zeta $). The dashed red curve and shaded band show the fitted ansatz $c+d/\hat \zeta ^2$ of Eq.~\ref {eq:zetahat_extrap_ansatz}, with each panel's Jackknife $\chi ^2/\text {dof}$ noted in its title; the blue square at $1/\hat \zeta =0$ marks the extrapolated physical-limit value. The parameters $c_{\text {re}}$, $c_{\text {im}}$, and $c_{\text {reA12B}}$ are shown rescaled by $1/P_L^2$, and $a_{\text {im}}$ by $1/P_L$, as described in the text.\relax }}{159}{figure.caption.105}%
\contentsline {figure}{\numberline {74}{\ignorespaces Unpolarized and Sivers TMD amplitudes reconstructed from the extrapolated ($\hat \zeta \to \infty $) fit parameters of Fig.~\ref {fig:param_extrapolation_zetahat}, evaluated as continuous functions of $x$ at fixed transverse separation $|b_T| = 3a \approx 0.34$ fm: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Im}}_{2B}$, the full unpolarized combination $\tilde f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]}_{2B}$, and the Sivers combination $\tilde f_{1T}^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{12B}$. Shaded bands are the Jackknife uncertainty propagated from the twelve extrapolated parameters.\relax }}{160}{figure.caption.106}%
\contentsline {figure}{\numberline {75}{\ignorespaces Sivers shift $\langle k_y \rangle _{TU}$ and $x\langle k_y \rangle _{TU}$ built from the extrapolated amplitudes of Fig.~\ref {fig:extrapolated_amplitude_level_amps}, restricted to the quark region $x\ge 0$. Shaded bands are the Jackknife uncertainty.\relax }}{160}{figure.caption.107}%
\contentsline {figure}{\numberline {76}{\ignorespaces The four extrapolated ($\hat \zeta \to \infty $) amplitude quantities of Fig.~\ref {fig:extrapolated_amplitude_level_amps}, shown as surfaces in $x$ and $|b_T|$ (from $3a\approx 0.34$ fm to $\sqrt {68}\,a\approx 0.94$ fm). The joint $x$-$|b_T|$ dependence shows how the reconstructed amplitudes change with transverse quark separation at the physical limit.\relax }}{161}{figure.caption.109}%
\contentsline {figure}{\numberline {77}{\ignorespaces The extrapolated Sivers shift $\langle k_y \rangle _{TU}$ and $x\langle k_y \rangle _{TU}$ of Fig.~\ref {fig:extrapolated_amplitude_level_sivers}, shown as surfaces in $x\ge 0$ and $|b_T|$ over the same range.\relax }}{162}{figure.caption.110}%
\contentsline {figure}{\numberline {78}{\ignorespaces Comparison, at fixed $|b_T| = 3a \approx 0.34$ fm, between the four amplitude quantities evaluated at each of the four simulated momenta ($P_L=-1,-2,-3,-4$, colored curves, each using its own unextrapolated fit parameters) and the extrapolated $\hat \zeta \to \infty $ result (black dashed curve), which uses only $P_L=-2,-3,-4$. The extrapolated curve differs from all three finite-momentum curves used in the extrapolation, including the one at the largest simulated momentum, so the fit-parameter extrapolation of Fig.~\ref {fig:param_extrapolation_zetahat} captures real momentum dependence and does not just reproduce the $P_L=-4$ result.\relax }}{162}{figure.caption.111}%
\contentsline {figure}{\numberline {79}{\ignorespaces The same comparison as Fig.~\ref {fig:momenta_vs_extrapolated_amps} for the Sivers shift $\langle k_y \rangle _{TU}$ and $x\langle k_y \rangle _{TU}$ ($x\ge 0$).\relax }}{163}{figure.caption.112}%
\contentsline {figure}{\numberline {80}{\ignorespaces Left and center: the optimal separable factors $g(x)$ and $h(|b_T|)$ (Eqs.~\eqref {eq:factorization_h_solution}-\eqref {eq:factorization_g_selfconsistent}, normalized so $\text {mean}[g^2]=1$) for the extrapolated Sivers shift, shown for all four $x$-windows of Table~\ref {tab:factorization_sivers}. Right: the reconstructed $g(x)h(|b_T|)$ (dashed) compared to the actual extrapolated Sivers shift (solid) at the smallest and largest fitted $|b_T|$, using the $x\in [0,1]$ fit; the visible gap between the solid and dashed curves is the residual quantified in Table~\ref {tab:factorization_sivers}.\relax }}{166}{figure.caption.114}%
\contentsline {figure}{\numberline {81}{\ignorespaces $R_b(x) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(x,0.34\text { fm})$ for four values of $|b_T|$, as a function of $x$. Under exact factorization each curve would be flat. Instead, every curve rises from its $x\to 0$ value to a peak near $x\approx 0.1$ before decaying, so the $|b_T|$-dependence of the Sivers shift itself depends on $x$.\relax }}{166}{figure.caption.115}%
\contentsline {figure}{\numberline {82}{\ignorespaces $R_x(|b_T|) = \langle k_y \rangle _{TU}(x,|b_T|)/\langle k_y \rangle _{TU}(0.3,|b_T|)$ for four values of $x$, as a function of $|b_T|$. The $x=0.2$ curve changes by more than a factor of two across the fitted $|b_T|$ range instead of staying flat, so the $x$-dependence of the Sivers shift itself depends on $|b_T|$, consistent with Fig.~\ref {fig:factorization_ratio_x_sivers}.\relax }}{167}{figure.caption.116}%
\contentsline {figure}{\numberline {83}{\ignorespaces The same ratio test as Fig.~\ref {fig:factorization_ratio_x_sivers}, $R_b(x)$, repeated at each finite momentum individually using its own raw (unextrapolated) fit parameters. None of the four panels shows a flat curve, so the non-factorization is a feature of the fitted amplitudes and not an artifact of the $\hat \zeta \to \infty $ extrapolation.\relax }}{168}{figure.caption.117}%
\contentsline {figure}{\numberline {84}{\ignorespaces The same ratio test as Fig.~\ref {fig:factorization_ratio_bT_sivers}, $R_x(|b_T|)$, repeated at each finite momentum individually. The departure from flatness grows with $|P_L|$, most visibly in the $x=0.2$ curve, which is consistent with the parameter mismatch identified in the extrapolated $j_X$ and $d_X$ values above.\relax }}{169}{figure.caption.118}%
\contentsline {figure}{\numberline {85}{\ignorespaces Optimal separable factor $g(x)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows (normalized so $\text {mean}[g^2]=1$). Each amplitude's $g(x)$ is dominated by a sharp rise as $x\to 0$, which steepens as the window narrows and reflects the Bessel-function behavior at small $x$.\relax }}{170}{figure.caption.120}%
\contentsline {figure}{\numberline {86}{\ignorespaces Optimal separable factor $h(|b_T|)$ for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}, for all four $x$-windows. For all four amplitudes, $h(|b_T|)$ falls smoothly with increasing $|b_T|$, but its magnitude and slope depend on the $x$-window used to define the fit, which itself signals imperfect factorization.\relax }}{171}{figure.caption.121}%
\contentsline {figure}{\numberline {87}{\ignorespaces Reconstructed $g(x)h(|b_T|)$ (dashed) against the actual extrapolated amplitude data (solid) at the smallest and largest fitted $|b_T|$, using the $x\in [0,1]$ fit, for each of the four amplitude combinations of Table~\ref {tab:factorization_amplitudes}. The largest reconstruction gap appears near $x\to 0$ for every amplitude, consistent with the $x\in [0,1]$ column of Table~\ref {tab:factorization_amplitudes} having the largest relative distance in every row.\relax }}{172}{figure.caption.122}%
