\contentsline {figure}{\numberline {55}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-2,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{136}{figure.caption.79}%
\contentsline {figure}{\numberline {56}{\ignorespaces $x$-dependence at $b^2=9a^2$ for $P_L=-2$. Top row: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{2B}$, $i\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Im}}_{2B}$, and $\tilde f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]}_{2B}$. Bottom row: $\tilde f_{1T}^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{12B}$, $\langle k_y\rangle _{TU}$, and $x\langle k_y\rangle _{TU}$. Bands show the Jackknife uncertainty.\relax }}{138}{figure.caption.81}%
