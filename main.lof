\contentsline {figure}{\numberline {31}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{48}{figure.caption.28}%
\contentsline {figure}{\numberline {32}{\ignorespaces $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{12B}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-4,0,0\}$ at fixed $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space.\relax }}{49}{figure.caption.29}%
\contentsline {figure}{\numberline {33}{\ignorespaces Failure of Gaussian model fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$ (with $\alpha -\beta = -0.0427(27)$ and $\chi ^2/\text {dof}\approx 235$) and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ (with $\alpha -\beta = -0.022(25)$ and$\chi ^2/\text {dof}\approx 1.4$) amplitudes.\relax }}{52}{figure.caption.30}%
\contentsline {figure}{\numberline {34}{\ignorespaces Failure of the simple Gaussian model fit for the imaginary $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Im}_{2B}$ (with $\alpha -\beta = 0.008\pm 0.017$ and$\chi ^2/\text {dof}\approx 2.9$) amplitude.\relax }}{53}{figure.caption.31}%
\contentsline {figure}{\numberline {35}{\ignorespaces Plots of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$ amplitude showing data $|\ensuremath {\boldsymbol {b}}| < 3a$ curving in opposite way that data at $|\ensuremath {\boldsymbol {b}}| \ge 3a$ for fixed momentum ($P=-1$) and fixed $\eta $ (say $\eta =8$)\relax }}{55}{figure.caption.32}%
\contentsline {figure}{\numberline {36}{\ignorespaces Plots of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{12B}$ amplitude showing data $|\ensuremath {\boldsymbol {b}}| < 3a$ curving in opposite way that data at $|\ensuremath {\boldsymbol {b}}| \ge 3a$ for fixed momentum ($P=-1$) and fixed $\eta $ (say $\eta =8$)\relax }}{55}{figure.caption.33}%
\contentsline {figure}{\numberline {37}{\ignorespaces Flowchart illustrating the evolutionary loop of the Genetic Algorithm utilized by \texttt {PySR} to discover analytical equations. The process continuously optimizes the population of mathematical expressions against the custom physics-informed loss function.\relax }}{56}{figure.caption.34}%
\contentsline {figure}{\numberline {38}{\ignorespaces Multi-panel comparison of the top \texttt {PySR}-discovered analytical models ($C = 11, 14, 16, 17$) against the lattice data for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ at fixed staple extents $\eta = 6, 7, 8, 10$ (with $P_1 = -1$ and $|\ensuremath {\boldsymbol {b}}| \geq 3a$). Each panel displays the amplitude as a function of the longitudinal separation $b_L/a$ at fixed transverse separations $b_T$, with the four Pareto-front models overlaid. The two exponential-$\eta $ models ($C = 14$, solid; $C = 16$, dashed) provide the most balanced description across all $\eta $ values, while the pure power-law-$\eta $ models ($C = 11$, dotted; $C = 17$, dot-dashed) exhibit slight systematic deviations at the extremes of the $\eta $ range.\relax }}{62}{figure.caption.37}%
\contentsline {figure}{\numberline {39}{\ignorespaces Diagnostic straight-line test for the Gaussian hypothesis. If the amplitude followed a pure Gaussian profile $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}} \propto e^{-c\,b^2}$, the data would appear as a straight line on a logarithmic ordinate versus $b^2$ (red dashed line, optimal Gaussian fit with $c = 0.058$). The lattice data (black markers) exhibit clear upward curvature away from the Gaussian baseline at large $b^2$, indicating a heavier-than-Gaussian tail that is accurately captured by the \texttt {PySR}-discovered power-law form $(1 + b^2)^{-1.39}$ (blue solid line). This provides direct, model-independent evidence that the spatial decay of the non-local quark bilinear is governed by an algebraic power law rather than a Gaussian exponential.\relax }}{63}{figure.caption.38}%
\contentsline {figure}{\numberline {40}{\ignorespaces Summary of various functional fits for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{Re}_{2B}$ for $7\leq \eta \leq 10$, $b\geq 3$ and $P_L=-1$\relax }}{65}{figure.caption.39}%
