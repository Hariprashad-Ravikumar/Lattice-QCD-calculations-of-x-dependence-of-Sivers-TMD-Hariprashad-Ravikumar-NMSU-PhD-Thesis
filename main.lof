\contentsline {figure}{\numberline {36}{\ignorespaces The $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ amplitude at fixed momentum ($P=-1$) and fixed $\eta $ (here $\eta =8$). The short-distance data ($|\ensuremath {\boldsymbol {b}}| < 3a$) curve in the opposite direction to the long-distance data ($|\ensuremath {\boldsymbol {b}}| \ge 3a$).\relax }}{108}{figure.caption.48}%
\contentsline {figure}{\numberline {37}{\ignorespaces The $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitude at fixed momentum ($P=-1$) and fixed $\eta $ (here $\eta =8$). The short-distance data ($|\ensuremath {\boldsymbol {b}}| < 3a$) curve in the opposite direction to the long-distance data ($|\ensuremath {\boldsymbol {b}}| \ge 3a$).\relax }}{109}{figure.caption.49}%
\contentsline {figure}{\numberline {38}{\ignorespaces The top \texttt {PySR} analytical models ($C = 11, 14, 16, 17$) compared with the lattice data for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ at fixed staple extents $\eta = 6, 7, 8, 10$ (with $P_1 = -1$ and $|\ensuremath {\boldsymbol {b}}| \geq 3a$). Each panel shows the amplitude as a function of the longitudinal separation $b_L/a$ at fixed transverse separations $b_T$, with the four Pareto-front models overlaid. The model curves are drawn only in the fitted region $|\ensuremath {\boldsymbol {b}}| \geq 3a$. The two exponential-$\eta $ models ($C = 14$, solid; $C = 16$, dashed) give the most balanced description of the data across all $\eta $ values, while the pure power-law-$\eta $ models ($C = 11$, dotted; $C = 17$, dot-dashed) deviate slightly and systematically at the ends of the $\eta $ range.\relax }}{115}{figure.caption.52}%
\contentsline {figure}{\numberline {39}{\ignorespaces Diagnostic straight-line test for the Gaussian hypothesis. If the amplitude followed a pure Gaussian profile $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}} \propto e^{-c\,b^2}$, the data would appear as a straight line on a logarithmic ordinate versus $b^2$ (red dashed line, best Gaussian fit with $c = 0.058$). The lattice data (black markers) curve upward away from the Gaussian line at large $b^2$, indicating a heavier-than-Gaussian tail, which the \texttt {PySR} power-law form $(1 + b^2)^{-1.39}$ (blue solid line) accurately captures. The curvature is direct, model-independent evidence that the spatial decay of the non-local quark bilinear follows an algebraic power law rather than a Gaussian exponential.\relax }}{116}{figure.caption.53}%
\contentsline {figure}{\numberline {40}{\ignorespaces Straight-line test for an exponential decay in $|\ensuremath {\boldsymbol {b}}|=\sqrt {b^2}$. A profile $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}\propto e^{-c|\ensuremath {\boldsymbol {b}}|}$ is a straight line on a logarithmic ordinate versus $|\ensuremath {\boldsymbol {b}}|/a$ (red dashed line, best fit $c=0.579$ with the same $\eta $ factor as the Gaussian baseline of Figure~\ref {fig:gaussian_straightline_test}). The \texttt {PySR} power law $(1+b^2)^{-1.39}$ (blue solid line) is shown for comparison. Over $3\le |\ensuremath {\boldsymbol {b}}|/a\le 8.2$ the exponential describes $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ at least as well as the power law.\relax }}{117}{figure.caption.54}%
\contentsline {figure}{\numberline {41}{\ignorespaces Sequential Lorentzian fits for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ at individual $\eta $ slices, holding the global power $j=2$ and amplitude $a=4$ constant.\relax }}{123}{figure.caption.60}%
\contentsline {figure}{\numberline {42}{\ignorespaces The extracted parameter $c(\eta )$ overlaid with the candidate asymptotic models $c_1(\eta ),\ldots ,c_{10}(\eta )$. The extracted values approach an asymptote at large $\eta $.\relax }}{123}{figure.caption.61}%
\contentsline {figure}{\numberline {43}{\ignorespaces The extracted parameter $d(\eta )$, which shows no visible dependence on the staple extent $\eta $.\relax }}{123}{figure.caption.62}%
\contentsline {figure}{\numberline {44}{\ignorespaces Lattice extracted parameters $c$ (left) and $d$ (right) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ as a function of $\eta $. Both parameters show no visible dependence on $\eta $.\relax }}{124}{figure.caption.64}%
\contentsline {figure}{\numberline {45}{\ignorespaces Lattice extracted parameters $c$ (left) and $d$ (right) for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ as a function of $\eta $. The data are noisier than for the real amplitudes, but consistent with the constant-parameter ansatz.\relax }}{125}{figure.caption.66}%
\contentsline {figure}{\numberline {46}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{129}{figure.caption.68}%
\contentsline {figure}{\numberline {47}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{130}{figure.caption.69}%
\contentsline {figure}{\numberline {48}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space with the global simultaneous fit overlaid.\relax }}{130}{figure.caption.70}%
\contentsline {figure}{\numberline {49}{\ignorespaces Fit for $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Re}}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}^{\text {Im}}$ \& $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}^{\text {Re}}$ amplitudes for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$ at a fixed staple extent $\eta |\ensuremath {\boldsymbol {v}}|/a=8$. The top two rows display the $(b_{L}/a,b_{T}/a)-$space, while the bottom two rows display the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2)-$space with the fit.\relax }}{131}{figure.caption.71}%
\contentsline {figure}{\numberline {50}{\ignorespaces $x$-dependence at $b^2=9a^2$ for $P_L=-1$. Top row: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{2B}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Im}}_{2B}$, and $\tilde f_1^{(0)}=2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]}_{2B}$. Bottom row: $\tilde f_{1T}^{\perp (1)}=-2\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}^{[x]\text {Re}}_{12B}$, $\langle k_y\rangle _{TU}$, and $x\langle k_y\rangle _{TU}$. Bands show the Jackknife uncertainty.\relax }}{133}{figure.caption.73}%
