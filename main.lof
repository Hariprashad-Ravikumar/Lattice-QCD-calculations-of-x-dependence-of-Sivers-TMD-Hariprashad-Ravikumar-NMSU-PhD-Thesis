\contentsline {figure}{\numberline {1}{\ignorespaces Relations between the distributions that describe the quark structure of the nucleon. Integrating the generalized TMDs (or their Fourier transforms, the Wigner distributions) over transverse position gives TMDs, and integrating over transverse momentum gives GPDs. The collinear PDFs are obtained from TMDs by integrating over $\ensuremath {\boldsymbol {k}}_{\mathrm T}$ and from GPDs in the forward limit. Moments of GPDs in $x$ give the elastic form factors.\relax }}{3}{figure.caption.4}%
\contentsline {figure}{\numberline {2}{\ignorespaces Schematic picture of the Sivers effect. For a nucleon moving into the page ($\ensuremath {\boldsymbol {P}}$ along $\hat {\ensuremath {\boldsymbol {z}}}$) with transverse spin $\ensuremath {\boldsymbol {S}}_{\mathrm T}$ along $\hat {\ensuremath {\boldsymbol {y}}}$, the second term of Eq.~\eqref {eq:intro_sivers_density} becomes $-\,k_x f_{1T}^\perp /m_N$. A nonzero Sivers function therefore shifts the density of unpolarized quarks along $\hat {\ensuremath {\boldsymbol {x}}}$, perpendicular to both $\ensuremath {\boldsymbol {P}}$ and $\ensuremath {\boldsymbol {S}}_{\mathrm T}$ (solid circle), relative to the symmetric unpolarized distribution (dashed). The shift shown, toward $+\hat {\ensuremath {\boldsymbol {x}}}$, corresponds to $f_{1T}^\perp <0$.\relax }}{5}{figure.caption.5}%
\contentsline {figure}{\numberline {3}{\ignorespaces Handbag diagram for the leading contribution to the DIS hadronic tensor. The virtual photon scatters off a quark of momentum $k$ with $k^+ = xP^+$, and the lower blob is the quark-quark correlator whose $\gamma ^+$ projection gives the PDF $f_1(x)$. The dashed line indicates the sum over final states.\relax }}{17}{figure.caption.6}%
\contentsline {figure}{\numberline {4}{\ignorespaces Staple-shaped gauge links connecting the quark fields at $0$ and $b$ in the TMD correlator, Eq.~\eqref {eq:tmd_correlator_simple}. (a) In SIDIS the link runs to $+\infty $ along the light-cone direction $\ensuremath {n}$ of the outgoing quark, Eq.~\eqref {eq:staple_sidis}. (b) In Drell-Yan it runs to $-\infty $, Eq.~\eqref {eq:staple_dy}. The dashed segment is the transverse link at infinity. In the lattice calculation the legs have finite length $\eta |v|$ along a space-like direction $v$, and the two cases correspond to $\eta v{\cdot }P\to +\infty $ and $\eta v{\cdot }P\to -\infty $ \cite {Musch:2011er}.\relax }}{22}{figure.caption.7}%
\contentsline {figure}{\numberline {5}{\ignorespaces Directions of the spatial staple vectors $\ensuremath {\boldsymbol {v}}$ mapped in the $v_1-v_3$ plane. Each vector corresponds to the requisite geometry to satisfy the $b \cdot P \neq 0$ constraint for the four sequential Collins-Soper parameters $\hat {\zeta }$.\relax }}{44}{figure.caption.11}%
\contentsline {figure}{\numberline {6}{\ignorespaces Ideal continuous trajectory of the off-axis staple vector (solid blue) for $P_1 = -1$. Circular markers indicate target continuous coordinates for sequential values of $\eta $. Dashed lines illustrate the discrete, step-wise permutations of gauge links used to reach the surrounding bounding integer lattice sites.\relax }}{46}{figure.caption.12}%
\contentsline {figure}{\numberline {7}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -1$. Empty brackets $\{\}$ denote a zero-length origin link, while numerical arrays (e.g., $\{1,3,1\}$) explicitly dictate the sequential directional steps.\relax }}{46}{figure.caption.12}%
\contentsline {figure}{\numberline {8}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -2$.\relax }}{46}{figure.caption.13}%
\contentsline {figure}{\numberline {9}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -2$.\relax }}{46}{figure.caption.13}%
\contentsline {figure}{\numberline {10}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -3$.\relax }}{46}{figure.caption.14}%
\contentsline {figure}{\numberline {11}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -3$.\relax }}{46}{figure.caption.14}%
\contentsline {figure}{\numberline {12}{\ignorespaces Ideal continuous trajectory and corresponding discrete bounding paths for the off-axis staple vector at $P_1 = -4$.\relax }}{47}{figure.caption.15}%
\contentsline {figure}{\numberline {13}{\ignorespaces Discrete gauge link configurations defining the interpolation bounds for $P_1 = -4$.\relax }}{47}{figure.caption.15}%
\contentsline {figure}{\numberline {14}{\ignorespaces Illustration of path degeneracy. Two distinct step-wise gauge link permutations (e.g., solid and dashed lines) terminate at the identical discrete lattice coordinate. The correlators from these equivalent paths are averaged to suppress local gauge noise prior to interpolation.\relax }}{47}{figure.caption.16}%
\contentsline {figure}{\numberline {15}{\ignorespaces Quadratic interpolation of the real and imaginary parts of the correlation function for $\ensuremath {\boldsymbol {b}}=\{1,2,0\}$, $\eta =7$, and $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=(-1,0,0)$. Red markers indicate the path-averaged lattice data points as a function of their deviation from the ideal constraint trajectory, $\Delta v_1 = (v_1^{\text {constraint}} - v_1^{\text {lattice}})/a$. The gray band indicates the quadratic fit (`InterpolationOrder $\rightarrow $ 2`), and the central blue marker represents the final extracted value at $\Delta v_1 = 0$, lying exactly on the required off-axis spatial trajectory.\relax }}{49}{figure.caption.17}%
\contentsline {figure}{\numberline {16}{\ignorespaces The sampled operator separation vectors mapped in the spatial $b_1-b_2$ plane (where $b_1 \equiv b_L$ and $b_2 \equiv b_T$).\relax }}{50}{figure.caption.18}%
\contentsline {figure}{\numberline {17}{\ignorespaces Mapping of the spatial lattice vectors into the physical invariant Variable Space $(b \cdot P/(2\pi ), |b|/a)$. The trajectories diverge based on the selected target $\hat {\zeta }$.\relax }}{50}{figure.caption.18}%
\contentsline {figure}{\numberline {18}{\ignorespaces Coverage of the quark separation vectors across the simulated lattice volume and their corresponding physical Variable Space representation.\relax }}{50}{figure.caption.18}%
\contentsline {figure}{\numberline {19}{\ignorespaces Discrete gauge link configurations for strictly transverse quark separations ($\ensuremath {\boldsymbol {b}} = \{0, b_2, b_3\}$). Numerical arrays dictate the sequential lattice steps (e.g., `2` represents a shift in the $x_2$ direction).\relax }}{51}{figure.caption.19}%
\contentsline {figure}{\numberline {20}{\ignorespaces Gauge link sequences for $+b_1$ (positive longitudinal separation).\relax }}{52}{figure.caption.20}%
\contentsline {figure}{\numberline {21}{\ignorespaces Mirrored gauge link sequences for $-b_1$ (negative longitudinal separation).\relax }}{52}{figure.caption.20}%
\contentsline {figure}{\numberline {22}{\ignorespaces Symmetric sets of step-wise gauge link paths required to access finite $\pm b \cdot P$ and isolate the real and imaginary components of the invariant amplitudes.\relax }}{52}{figure.caption.20}%
\contentsline {figure}{\numberline {23}{\ignorespaces Illustration of path degeneracy for the quark separation vector $\ensuremath {\boldsymbol {b}}$. Distinct step-wise permutations (solid and dashed lines) terminating at the same Cartesian coordinate are averaged to suppress local gauge noise.\relax }}{53}{figure.caption.21}%
\contentsline {figure}{\numberline {24}{\ignorespaces The full network of path-averaged $\ensuremath {\boldsymbol {b}}$ vectors in the $b_1/a - b_2/a$ plane. Solid red lines represent the ideal vectors, while dashed lines illustrate the underlying degenerate staircase paths calculated and averaged on the discrete lattice.\relax }}{53}{figure.caption.22}%
\contentsline {figure}{\numberline {25}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{2B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{66}{figure.caption.23}%
\contentsline {figure}{\numberline {26}{\ignorespaces Real and imaginary parts of the $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle A$}\mathaccent "0365{A}_{12B}$ amplitude for $\ensuremath {\boldsymbol {P}}\cdot a\hat {L}/(2\pi )=\{-1,0,0\}$. The top row displays the $(b_{L}/a,b_{T}/a,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space, while the bottom row displays the $((\ensuremath {\boldsymbol {P}}\cdot \ensuremath {\boldsymbol {b}})\cdot \hat {L}/(2\pi ),b^{2}/a^2,\eta |\ensuremath {\boldsymbol {v}}|/a)-$space.\relax }}{66}{figure.caption.24}%
